' =========================================================
' Commented source copy for the Amiga ANIM backend.
' Explanatory comments were added in English without altering executable code.
' =========================================================
' AMIGA ANIM backend prepared for unified Anim... dispatcher
' Public names use AmgAnim... prefix.

$INCLUDEONCE

' Purpose: Open an Amiga ANIM/IFF file, parse ILBM-derived structures, and prepare playback.
' Parameters: fileName = string holding a file path or a human-readable name.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimOpen& (fileName AS STRING)
    AmgAnimOpen = AmgAnimOpenLimit(fileName, 0, 0, 0)
END FUNCTION

' Purpose: Open an Amiga ANIM/IFF file, parse ILBM-derived structures, and prepare playback.
' Parameters: fileName = string holding a file path or a human-readable name; maxWidth = maximum allowed width; maxHeight = maximum allowed height; maxFrames = maximum allowed frames.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimOpenLimit& (fileName AS STRING, maxWidth AS LONG, maxHeight AS LONG, maxFrames AS LONG)
    ' Variable: anim stores the working value for animation.
    DIM anim AS AmgAnimInfo
    ' dynamic array: frames is resized here to hold the dynamic array that stores per-frame data or cached frame metadata.
    REDIM frames(0 TO 0) AS AmgAnimFrameInfo
    ' dynamic array: pal is resized here to hold the working value for pal.
    REDIM pal(0 TO 0) AS AmgAnimRGB8
    ' Variable: ok stores the success flag returned by the current routine.
    DIM ok AS LONG
    ' Variable: slotId stores the working value for slot id.
    DIM slotId AS LONG
    ' Variable: frameStart stores the working value for frame start.
    DIM frameStart AS LONG
    ' Variable: frameIndex stores the index variable used to address the current item.
    DIM frameIndex AS LONG
    ' Variable: imageHandle stores the QB64 image handle used to store or draw decoded pixels.
    DIM imageHandle AS LONG
    ' Variable: dataStart stores the buffer that holds raw, packed, or decoded byte data.
    DIM dataStart AS LONG
    ' Variable: totalPlanar stores the working value for total planar.
    DIM totalPlanar AS LONG
    ' Variable: totalChunky stores the working value for total chunky.
    DIM totalChunky AS LONG
    ' Variable: palCount stores the count used to size or iterate the current data set.
    DIM palCount AS LONG
    ' Variable: snapshotCount stores the count used to size or iterate the current data set.
    DIM snapshotCount AS LONG

    AmgAnimOpenLimit = -1
    ok = 0
    slotId = -1
    imageHandle = -1
    dataStart = -1

    IF _FILEEXISTS(fileName) = 0 THEN EXIT FUNCTION

    dataStart = AmgAnimLoadFileToDataPool(fileName, ok)
    IF ok = 0 THEN EXIT FUNCTION
    IF dataStart < 0 THEN EXIT FUNCTION
    amg_anim_active_mode = 1
    amg_anim_active_pool_ofs = dataStart
    amg_anim_active_pool_size = AmgAnimAllocDataBlockSize(dataStart)

    AmgAnimLoadIndex anim, frames(), pal()
    IF anim.frameCount <= 0 THEN EXIT FUNCTION
    IF anim.w <= 0 OR anim.h <= 0 THEN EXIT FUNCTION

    IF maxWidth > 0 THEN
        IF anim.w > maxWidth THEN EXIT FUNCTION
    END IF

    IF maxHeight > 0 THEN
        IF anim.h > maxHeight THEN EXIT FUNCTION
    END IF

    IF maxFrames > 0 THEN
        IF anim.frameCount > maxFrames THEN EXIT FUNCTION
    END IF

    slotId = AmgAnimAllocSlot
    IF slotId < 0 THEN EXIT FUNCTION

    AmgAnimInitSlot slotId
    AmgAnimFileNames(slotId) = fileName
    AmgAnimItems(slotId).Used = -1
    AmgAnimItems(slotId).WidthPx = anim.w
    AmgAnimItems(slotId).HeightPx = anim.h
    AmgAnimItems(slotId).FrameCount = anim.frameCount
    AmgAnimItems(slotId).CurrentFrame = 0
    AmgAnimItems(slotId).LoopMode = AMG_ANIM_LOOP_FILE_DEFAULT
    AmgAnimItems(slotId).NPlanes = anim.nPlanes
    AmgAnimItems(slotId).RowBytes = anim.rowBytes
    AmgAnimItems(slotId).PlaneSize = anim.planeSize
    AmgAnimItems(slotId).Compression = anim.compression
    AmgAnimItems(slotId).Camg = anim.camg
    AmgAnimItems(slotId).IsHam = anim.isHAM
    AmgAnimItems(slotId).RenderedFrame = -1
    AmgAnimItems(slotId).DecodedFrame = -1
    AmgAnimItems(slotId).ShownIsA = -1
    AmgAnimItems(slotId).WorkReady = 0

    frameStart = AmgAnimAppendFrameBlock(anim.frameCount)
    IF frameStart < 0 THEN
        AmgAnimSetError slotId, "AmgAnimOpenLimit: frame pool allocation failed"
        AmgAnimInitSlot slotId
        EXIT FUNCTION
    END IF

    ' Loop purpose: iterate through animation frames while building, seeking, or updating playback state.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR frameIndex = 0 TO anim.frameCount - 1
        AmgAnimFrames(frameStart + frameIndex) = frames(frameIndex)
    NEXT frameIndex
    AmgAnimItems(slotId).FrameStart = frameStart

    AmgAnimItems(slotId).FileDataStart = dataStart
    AmgAnimItems(slotId).FileDataSize = amg_anim_active_pool_size

    totalPlanar = anim.rowBytes * anim.h * anim.nPlanes
    totalChunky = anim.w * anim.h
    palCount = UBOUND(pal) + 1
    IF totalPlanar <= 0 THEN
        AmgAnimSetError slotId, "AmgAnimOpenLimit: invalid planar size"
        AmgAnimInitSlot slotId
        EXIT FUNCTION
    END IF
    IF totalChunky <= 0 THEN
        AmgAnimSetError slotId, "AmgAnimOpenLimit: invalid chunky size"
        AmgAnimInitSlot slotId
        EXIT FUNCTION
    END IF
    IF palCount <= 0 THEN palCount = 1

    snapshotCount = AmgAnimCountSnapshots(anim.frameCount, AMG_ANIM_SNAPSHOT_INTERVAL)

    AmgAnimItems(slotId).WorkBaseStart = AmgAnimAllocPlanarBlock(totalPlanar)
    AmgAnimItems(slotId).WorkAStart = AmgAnimAllocPlanarBlock(totalPlanar)
    AmgAnimItems(slotId).WorkBStart = AmgAnimAllocPlanarBlock(totalPlanar)
    AmgAnimItems(slotId).ChunkyStart = AmgAnimAllocChunkyBlock(totalChunky)
    AmgAnimItems(slotId).PixelsStart = -1
    AmgAnimItems(slotId).PalStart = AmgAnimAllocPaletteBlock(palCount)
    AmgAnimItems(slotId).PalCount = palCount
    AmgAnimItems(slotId).SnapshotMetaStart = AmgAnimAllocSnapshotMetaBlock(snapshotCount)
    AmgAnimItems(slotId).SnapshotCount = snapshotCount
    AmgAnimItems(slotId).SnapshotInterval = AMG_ANIM_SNAPSHOT_INTERVAL
    IF snapshotCount > 0 THEN
        AmgAnimItems(slotId).SnapshotPlanarAStart = AmgAnimAllocPlanarBlock(snapshotCount * totalPlanar)
        AmgAnimItems(slotId).SnapshotPlanarBStart = AmgAnimAllocPlanarBlock(snapshotCount * totalPlanar)
        AmgAnimItems(slotId).SnapshotPaletteStart = AmgAnimAllocPaletteBlock(snapshotCount * palCount)
    ELSE
        AmgAnimItems(slotId).SnapshotPlanarAStart = -1
        AmgAnimItems(slotId).SnapshotPlanarBStart = -1
        AmgAnimItems(slotId).SnapshotPaletteStart = -1
    END IF

    IF AmgAnimItems(slotId).WorkBaseStart < 0 THEN
        AmgAnimSetError slotId, "AmgAnimOpenLimit: work base allocation failed"
        AmgAnimInitSlot slotId
        EXIT FUNCTION
    END IF
    IF AmgAnimItems(slotId).WorkAStart < 0 THEN
        AmgAnimSetError slotId, "AmgAnimOpenLimit: work A allocation failed"
        AmgAnimInitSlot slotId
        EXIT FUNCTION
    END IF
    IF AmgAnimItems(slotId).WorkBStart < 0 THEN
        AmgAnimSetError slotId, "AmgAnimOpenLimit: work B allocation failed"
        AmgAnimInitSlot slotId
        EXIT FUNCTION
    END IF
    IF AmgAnimItems(slotId).ChunkyStart < 0 THEN
        AmgAnimSetError slotId, "AmgAnimOpenLimit: chunky allocation failed"
        AmgAnimInitSlot slotId
        EXIT FUNCTION
    END IF
    IF AmgAnimItems(slotId).PalStart < 0 THEN
        AmgAnimSetError slotId, "AmgAnimOpenLimit: palette allocation failed"
        AmgAnimInitSlot slotId
        EXIT FUNCTION
    END IF
    IF AmgAnimItems(slotId).SnapshotMetaStart < 0 THEN
        AmgAnimSetError slotId, "AmgAnimOpenLimit: snapshot meta allocation failed"
        AmgAnimInitSlot slotId
        EXIT FUNCTION
    END IF
    IF snapshotCount > 0 THEN
        IF AmgAnimItems(slotId).SnapshotPlanarAStart < 0 THEN
            AmgAnimSetError slotId, "AmgAnimOpenLimit: snapshot planar A allocation failed"
            AmgAnimInitSlot slotId
            EXIT FUNCTION
        END IF
        IF AmgAnimItems(slotId).SnapshotPlanarBStart < 0 THEN
            AmgAnimSetError slotId, "AmgAnimOpenLimit: snapshot planar B allocation failed"
            AmgAnimInitSlot slotId
            EXIT FUNCTION
        END IF
        IF AmgAnimItems(slotId).SnapshotPaletteStart < 0 THEN
            AmgAnimSetError slotId, "AmgAnimOpenLimit: snapshot palette allocation failed"
            AmgAnimInitSlot slotId
            EXIT FUNCTION
        END IF
    END IF

    AmgAnimCopyLocalPaletteToPool pal(), AmgAnimItems(slotId).PalStart, AmgAnimItems(slotId).PalCount

    imageHandle = _NEWIMAGE(anim.w, anim.h, 32)
    IF imageHandle > -2 THEN
        AmgAnimSetError slotId, "AmgAnimOpenLimit: failed to allocate canvas"
        AmgAnimInitSlot slotId
        EXIT FUNCTION
    END IF

    AmgAnimItems(slotId).CanvasImage = imageHandle
    AmgAnimCanvasMem(slotId) = _MEMIMAGE(imageHandle)
    IF _MEMEXISTS(AmgAnimCanvasMem(slotId)) = 0 THEN
        AmgAnimSetError slotId, "AmgAnimOpenLimit: failed to map canvas memory"
        IF imageHandle <= -2 THEN _FREEIMAGE imageHandle: imageHandle = 0
        AmgAnimItems(slotId).CanvasImage = 0
        AmgAnimInitSlot slotId
        EXIT FUNCTION
    END IF

    ' Delay first decode/render until the frame is actually requested.
    ' This removes one expensive decode pass from open time.
    AmgAnimItems(slotId).RenderedFrame = -1
    AmgAnimOpenLimit = slotId
END FUNCTION

' Purpose: Read Amiga ANIM metadata without fully opening the animation.
' Parameters: fileName = string holding a file path or a human-readable name; ok = success flag returned by the current routine; isAnim = Boolean-like flag used by the current routine; widthPx = decoded image width in pixels; heightPx = decoded image height in pixels; frameCount = total number of frames available for the current animation.
SUB AmgAnimProbe (fileName AS STRING, ok AS INTEGER, isAnim AS INTEGER, widthPx AS LONG, heightPx AS LONG, frameCount AS LONG)
    ' Variable: anim stores the working value for animation.
    DIM anim AS AmgAnimInfo
    ' dynamic array: frames is resized here to hold the dynamic array that stores per-frame data or cached frame metadata.
    REDIM frames(0 TO 0) AS AmgAnimFrameInfo
    ' dynamic array: pal is resized here to hold the working value for pal.
    REDIM pal(0 TO 0) AS AmgAnimRGB8
    ' Variable: okLong stores the working value for ok long.
    DIM okLong AS LONG

    ok = 0
    isAnim = 0
    widthPx = 0
    heightPx = 0
    frameCount = 0
    okLong = 0

    IF _FILEEXISTS(fileName) = 0 THEN EXIT SUB

    AmgAnimLoadFileToBuffer fileName, okLong
    IF okLong = 0 THEN EXIT SUB
    AmgAnimUseScratchBuffer

    AmgAnimLoadIndex anim, frames(), pal()
    IF anim.frameCount <= 0 THEN EXIT SUB
    IF anim.w <= 0 OR anim.h <= 0 THEN EXIT SUB

    ok = -1
    isAnim = -1
    widthPx = anim.w
    heightPx = anim.h
    frameCount = anim.frameCount
END SUB

' Purpose: Release all resources owned by one Amiga ANIM decoder instance.
' Parameters: animId = working value for animation id.
SUB AmgAnimClose (animId AS LONG)
    IF AmgAnimValidId(animId) = 0 THEN EXIT SUB
    IF amg_anim_scratch_owner_valid THEN
        IF amg_anim_scratch_owner = animId THEN amg_anim_scratch_owner_valid = 0
    END IF
    IF _MEMEXISTS(AmgAnimCanvasMem(animId)) THEN _MEMFREE AmgAnimCanvasMem(animId)
    IF AmgAnimItems(animId).CanvasImage <= -2 THEN _FREEIMAGE AmgAnimItems(animId).CanvasImage: AmgAnimItems(animId).CanvasImage = 0
    AmgAnimInitSlot animId
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation free all.
SUB AmgAnimFreeAll ()
    ' Variable: indexValue stores the working value for index value.
    DIM indexValue AS LONG

    ' Loop purpose: walk through every currently allocated element in AmgAnimItems.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR indexValue = 0 TO UBOUND(AmgAnimItems)
        IF AmgAnimItems(indexValue).Used THEN AmgAnimClose indexValue
    NEXT indexValue
    amg_anim_scratch_owner_valid = 0
END SUB

' Purpose: Start Amiga ANIM playback timing.
' Parameters: animId = working value for animation id.
SUB AmgAnimPlay (animId AS LONG)
    ' Variable: delaySec stores the frame delay or timing value.
    DIM delaySec AS DOUBLE
    ' Variable: nowValue stores the working value for now value.
    DIM nowValue AS DOUBLE

    IF AmgAnimValidId(animId) = 0 THEN EXIT SUB
    IF AmgAnimItems(animId).FrameCount <= 0 THEN EXIT SUB
    IF AmgAnimEnsureFrameRendered(animId, AmgAnimItems(animId).CurrentFrame) = 0 THEN EXIT SUB

    nowValue = TIMER
    delaySec = AmgAnimFrameDelaySec(animId, AmgAnimItems(animId).CurrentFrame)

    AmgAnimItems(animId).Playing = -1
    AmgAnimItems(animId).Paused = 0
    AmgAnimItems(animId).RemainingDelay = 0
    AmgAnimItems(animId).LastRawTimer = nowValue
    AmgAnimItems(animId).NextTick = AmgAnimTimeAdd(nowValue, delaySec)
END SUB

' Purpose: Stop Amiga ANIM playback timing.
' Parameters: animId = working value for animation id.
SUB AmgAnimStop (animId AS LONG)
    ' Variable: renderResult stores the working value for render result.
    DIM renderResult AS LONG

    IF AmgAnimValidId(animId) = 0 THEN EXIT SUB

    AmgAnimItems(animId).Playing = 0
    AmgAnimItems(animId).Paused = 0
    AmgAnimItems(animId).CurrentFrame = 0
    AmgAnimItems(animId).NextTick = 0
    AmgAnimItems(animId).RemainingDelay = 0
    AmgAnimItems(animId).LastRawTimer = 0
    renderResult = AmgAnimEnsureFrameRendered(animId, 0)
END SUB

' Purpose: Pause Amiga ANIM playback while keeping the current frame.
' Parameters: animId = working value for animation id.
SUB AmgAnimPause (animId AS LONG)
    ' Variable: nowValue stores the working value for now value.
    DIM nowValue AS DOUBLE

    IF AmgAnimValidId(animId) = 0 THEN EXIT SUB
    IF AmgAnimItems(animId).Playing = 0 THEN EXIT SUB
    IF AmgAnimItems(animId).Paused THEN EXIT SUB

    nowValue = TIMER
    AmgAnimItems(animId).RemainingDelay = AmgAnimTimeRemaining(AmgAnimItems(animId).NextTick, nowValue)
    AmgAnimItems(animId).Paused = -1
    AmgAnimItems(animId).LastRawTimer = nowValue
END SUB

' Purpose: Resume Amiga ANIM playback after a pause.
' Parameters: animId = working value for animation id.
SUB AmgAnimResume (animId AS LONG)
    ' Variable: nowValue stores the working value for now value.
    DIM nowValue AS DOUBLE

    IF AmgAnimValidId(animId) = 0 THEN EXIT SUB
    IF AmgAnimItems(animId).Playing = 0 THEN EXIT SUB
    IF AmgAnimItems(animId).Paused = 0 THEN EXIT SUB

    nowValue = TIMER
    AmgAnimItems(animId).Paused = 0
    AmgAnimItems(animId).LastRawTimer = nowValue
    AmgAnimItems(animId).NextTick = AmgAnimTimeAdd(nowValue, AmgAnimItems(animId).RemainingDelay)
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation set loop.
' Parameters: animId = working value for animation id; loopMode = loop policy that controls whether playback stops or repeats.
SUB AmgAnimSetLoop (animId AS LONG, loopMode AS LONG)
    IF AmgAnimValidId(animId) = 0 THEN EXIT SUB

    SELECT CASE loopMode
        CASE AMG_ANIM_LOOP_FILE_DEFAULT, AMG_ANIM_LOOP_FOREVER, AMG_ANIM_LOOP_ONCE
            AmgAnimItems(animId).LoopMode = loopMode
        CASE ELSE
            AmgAnimItems(animId).LoopMode = AMG_ANIM_LOOP_FILE_DEFAULT
    END SELECT
END SUB

' Purpose: Advance Amiga ANIM playback according to frame timing.
' Parameters: animId = working value for animation id.
SUB AmgAnimUpdate (animId AS LONG)
    ' Variable: nowValue stores the working value for now value.
    DIM nowValue AS DOUBLE
    ' Variable: nextFrame stores the working value for next frame.
    DIM nextFrame AS LONG
    ' Variable: delaySec stores the frame delay or timing value.
    DIM delaySec AS DOUBLE
    ' Variable: changed stores the working value for changed.
    DIM changed AS INTEGER
    ' Variable: allowLoop stores the working value for allow loop.
    DIM allowLoop AS INTEGER
    ' Variable: renderResult stores the working value for render result.
    DIM renderResult AS LONG

    IF AmgAnimValidId(animId) = 0 THEN EXIT SUB
    IF AmgAnimItems(animId).Playing = 0 THEN EXIT SUB
    IF AmgAnimItems(animId).Paused THEN EXIT SUB
    IF AmgAnimItems(animId).FrameCount <= 1 THEN EXIT SUB

    nowValue = TIMER
    changed = 0

    ' Loop purpose: keep processing until the controlling condition becomes false, usually while input or timing remains active.
    DO WHILE AmgAnimTimeReached(AmgAnimItems(animId).NextTick, nowValue)
        nextFrame = AmgAnimItems(animId).CurrentFrame + 1
        IF nextFrame >= AmgAnimItems(animId).FrameCount THEN
            allowLoop = 0
            IF AmgAnimItems(animId).LoopMode = AMG_ANIM_LOOP_FOREVER THEN allowLoop = -1
            IF allowLoop = 0 THEN
                AmgAnimItems(animId).CurrentFrame = AmgAnimItems(animId).FrameCount - 1
                AmgAnimItems(animId).Playing = 0
                AmgAnimItems(animId).Paused = 0
                AmgAnimItems(animId).NextTick = 0
                EXIT DO
            END IF
            nextFrame = 0
        END IF

        AmgAnimItems(animId).CurrentFrame = nextFrame
        delaySec = AmgAnimFrameDelaySec(animId, nextFrame)
        AmgAnimItems(animId).NextTick = AmgAnimTimeAdd(AmgAnimItems(animId).NextTick, delaySec)
        changed = -1
    LOOP

    AmgAnimItems(animId).LastRawTimer = nowValue
    IF changed THEN
        renderResult = AmgAnimEnsureFrameRendered(animId, AmgAnimItems(animId).CurrentFrame)
    END IF
END SUB

' Purpose: Draw the current Amiga ANIM frame to the active QB64 target.
' Parameters: animId = working value for animation id; x = horizontal pixel or coordinate index; y = vertical pixel or coordinate index.
SUB AmgAnimDraw (animId AS LONG, x AS LONG, y AS LONG)
    IF AmgAnimValidId(animId) = 0 THEN EXIT SUB
    IF AmgAnimEnsureFrameRendered(animId, AmgAnimItems(animId).CurrentFrame) = 0 THEN EXIT SUB
    IF AmgAnimItems(animId).CanvasImage > -2 THEN EXIT SUB
    _PUTIMAGE (x, y), AmgAnimItems(animId).CanvasImage, 0
END SUB

' Purpose: Draw the current Amiga ANIM frame to the active QB64 target.
' Parameters: animId = working value for animation id; x = horizontal pixel or coordinate index; y = vertical pixel or coordinate index; boxWidth = width value used by this routine; boxHeight = height value used by this routine.
SUB AmgAnimDrawFit (animId AS LONG, x AS LONG, y AS LONG, boxWidth AS LONG, boxHeight AS LONG)
    ' Variable: srcWidth stores the width value used by this routine.
    DIM srcWidth AS LONG
    ' Variable: srcHeight stores the height value used by this routine.
    DIM srcHeight AS LONG
    ' Variable: scaleX stores the working value for scale x.
    DIM scaleX AS DOUBLE
    ' Variable: scaleY stores the working value for scale y.
    DIM scaleY AS DOUBLE
    ' Variable: scaleValue stores the working value for scale value.
    DIM scaleValue AS DOUBLE
    ' Variable: drawWidth stores the width value used by this routine.
    DIM drawWidth AS LONG
    ' Variable: drawHeight stores the height value used by this routine.
    DIM drawHeight AS LONG
    ' Variable: drawX stores the working value for draw x.
    DIM drawX AS LONG
    ' Variable: drawY stores the working value for draw y.
    DIM drawY AS LONG

    IF AmgAnimValidId(animId) = 0 THEN EXIT SUB
    IF boxWidth <= 0 OR boxHeight <= 0 THEN EXIT SUB
    IF AmgAnimEnsureFrameRendered(animId, AmgAnimItems(animId).CurrentFrame) = 0 THEN EXIT SUB
    IF AmgAnimItems(animId).CanvasImage > -2 THEN EXIT SUB

    srcWidth = AmgAnimItems(animId).WidthPx
    srcHeight = AmgAnimItems(animId).HeightPx
    IF srcWidth <= 0 OR srcHeight <= 0 THEN EXIT SUB

    scaleX = boxWidth / srcWidth
    scaleY = boxHeight / srcHeight
    IF scaleX < scaleY THEN
        scaleValue = scaleX
    ELSE
        scaleValue = scaleY
    END IF
    IF scaleValue <= 0 THEN EXIT SUB

    drawWidth = _ROUND(srcWidth * scaleValue)
    drawHeight = _ROUND(srcHeight * scaleValue)
    IF drawWidth < 1 THEN drawWidth = 1
    IF drawHeight < 1 THEN drawHeight = 1

    drawX = x + (boxWidth - drawWidth) \ 2
    drawY = y + (boxHeight - drawHeight) \ 2
    _PUTIMAGE (drawX, drawY)-(drawX + drawWidth - 1, drawY + drawHeight - 1), AmgAnimItems(animId).CanvasImage, 0
END SUB

' Purpose: Draw the current Amiga ANIM frame to the active QB64 target.
' Parameters: animId = working value for animation id; x = horizontal pixel or coordinate index; y = vertical pixel or coordinate index; boxWidth = width value used by this routine; boxHeight = height value used by this routine.
SUB AmgAnimDrawStretch (animId AS LONG, x AS LONG, y AS LONG, boxWidth AS LONG, boxHeight AS LONG)
    IF AmgAnimValidId(animId) = 0 THEN EXIT SUB
    IF boxWidth <= 0 OR boxHeight <= 0 THEN EXIT SUB
    IF AmgAnimEnsureFrameRendered(animId, AmgAnimItems(animId).CurrentFrame) = 0 THEN EXIT SUB
    IF AmgAnimItems(animId).CanvasImage > -2 THEN EXIT SUB
    _PUTIMAGE (x, y)-(x + boxWidth - 1, y + boxHeight - 1), AmgAnimItems(animId).CanvasImage, 0
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation frame count.
' Parameters: animId = working value for animation id.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimFrameCount& (animId AS LONG)
    AmgAnimFrameCount = 0
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION
    AmgAnimFrameCount = AmgAnimItems(animId).FrameCount
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation width.
' Parameters: animId = working value for animation id.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimWidth& (animId AS LONG)
    AmgAnimWidth = 0
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION
    AmgAnimWidth = AmgAnimItems(animId).WidthPx
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation height.
' Parameters: animId = working value for animation id.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimHeight& (animId AS LONG)
    AmgAnimHeight = 0
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION
    AmgAnimHeight = AmgAnimItems(animId).HeightPx
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation current frame.
' Parameters: animId = working value for animation id.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimCurrentFrame& (animId AS LONG)
    AmgAnimCurrentFrame = 0
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION
    AmgAnimCurrentFrame = AmgAnimItems(animId).CurrentFrame
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation format.
' Parameters: animId = working value for animation id.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimFormat& (animId AS LONG)
    AmgAnimFormat = 0
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION
    AmgAnimFormat = AMG_ANIM_FMT_ANIM
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation is playing.
' Parameters: animId = working value for animation id.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimIsPlaying% (animId AS LONG)
    AmgAnimIsPlaying = 0
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION
    AmgAnimIsPlaying = AmgAnimItems(animId).Playing
END FUNCTION

' Purpose: Seek to a specific Amiga ANIM frame or time position.
' Parameters: animId = working value for animation id; frameIndex = index variable used to address the current item.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimSeekFrame% (animId AS LONG, frameIndex AS LONG)
    ' Variable: nowValue stores the working value for now value.
    DIM nowValue AS DOUBLE
    ' Variable: delaySec stores the frame delay or timing value.
    DIM delaySec AS DOUBLE

    AmgAnimSeekFrame = 0
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION
    IF frameIndex < 0 THEN EXIT FUNCTION
    IF frameIndex >= AmgAnimItems(animId).FrameCount THEN EXIT FUNCTION

    IF AmgAnimEnsureFrameRendered(animId, frameIndex) = 0 THEN EXIT FUNCTION

    delaySec = AmgAnimFrameDelaySec(animId, frameIndex)
    IF delaySec <= 0 THEN delaySec = 1# / 60#

    nowValue = TIMER
    AmgAnimItems(animId).CurrentFrame = frameIndex

    IF AmgAnimItems(animId).Playing THEN
        IF AmgAnimItems(animId).Paused THEN
            AmgAnimItems(animId).RemainingDelay = delaySec
            AmgAnimItems(animId).LastRawTimer = nowValue
        ELSE
            AmgAnimItems(animId).LastRawTimer = nowValue
            AmgAnimItems(animId).NextTick = AmgAnimTimeAdd(nowValue, delaySec)
            AmgAnimItems(animId).RemainingDelay = 0
        END IF
    ELSE
        AmgAnimItems(animId).NextTick = 0
        AmgAnimItems(animId).RemainingDelay = 0
        AmgAnimItems(animId).LastRawTimer = 0
    END IF

    AmgAnimSeekFrame = -1
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation is loaded.
' Parameters: animId = working value for animation id.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimIsLoaded% (animId AS LONG)
    AmgAnimIsLoaded = AmgAnimValidId(animId)
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation error.
' Parameters: animId = working value for animation id.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimError$ (animId AS LONG)
    AmgAnimError = ""
    IF animId < 0 THEN EXIT FUNCTION
    IF animId > UBOUND(AmgAnimErrorTexts) THEN EXIT FUNCTION
    AmgAnimError = AmgAnimErrorTexts(animId)
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation save frame.
' Parameters: animId = working value for animation id; frameIndex = index variable used to address the current item; fileName = string holding a file path or a human-readable name.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimSaveFrame% (animId AS LONG, frameIndex AS LONG, fileName AS STRING)
    ' Variable: imageHandle stores the QB64 image handle used to store or draw decoded pixels.
    DIM imageHandle AS LONG

    AmgAnimSaveFrame = 0
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION
    IF frameIndex < 0 THEN EXIT FUNCTION
    IF frameIndex >= AmgAnimItems(animId).FrameCount THEN EXIT FUNCTION
    IF LEN(fileName) = 0 THEN EXIT FUNCTION

    imageHandle = AmgAnimExtractFrameImageInternal(animId, frameIndex)
    IF imageHandle > -2 THEN EXIT FUNCTION

    _SAVEIMAGE fileName, imageHandle
    IF imageHandle <= -2 THEN _FREEIMAGE imageHandle: imageHandle = 0
    AmgAnimSaveFrame = -1
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation clone frame image.
' Parameters: animId = working value for animation id; frameIndex = index variable used to address the current item.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimCloneFrameImage& (animId AS LONG, frameIndex AS LONG)
    AmgAnimCloneFrameImage = -1
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION
    IF frameIndex < 0 THEN EXIT FUNCTION
    IF frameIndex >= AmgAnimItems(animId).FrameCount THEN EXIT FUNCTION
    AmgAnimCloneFrameImage = AmgAnimExtractFrameImageInternal(animId, frameIndex)
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation alloc slot.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimAllocSlot& ()
    ' Variable: indexValue stores the working value for index value.
    DIM indexValue AS LONG
    ' Variable: oldTop stores the working value for old top.
    DIM oldTop AS LONG

    AmgAnimAllocSlot = -1

    ' Loop purpose: walk through every currently allocated element in AmgAnimItems.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR indexValue = 0 TO UBOUND(AmgAnimItems)
        IF AmgAnimItems(indexValue).Used = 0 THEN
            AmgAnimAllocSlot = indexValue
            EXIT FUNCTION
        END IF
    NEXT indexValue

    oldTop = UBOUND(AmgAnimItems)
    ' dynamic array: AmgAnimItems is resized here to hold the dynamic table that stores one record per live object handled by this module.
    REDIM _PRESERVE AmgAnimItems(0 TO oldTop + 1) AS AmgAnimStore
    ' dynamic array: AmgAnimFileNames is resized here to hold the parallel array that remembers the source filename for each active entry.
    REDIM _PRESERVE AmgAnimFileNames(0 TO oldTop + 1) AS STRING
    ' dynamic array: AmgAnimErrorTexts is resized here to hold the text storage for the last human-readable error message.
    REDIM _PRESERVE AmgAnimErrorTexts(0 TO oldTop + 1) AS STRING
    REDIM _PRESERVE AmgAnimCanvasMem(0 TO oldTop + 1) AS _MEM
    AmgAnimAllocSlot = oldTop + 1
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation init slot.
' Parameters: animId = working value for animation id.
SUB AmgAnimInitSlot (animId AS LONG)
    IF animId < 0 THEN EXIT SUB
    IF animId > UBOUND(AmgAnimItems) THEN EXIT SUB

    IF amg_anim_scratch_owner_valid THEN
        IF amg_anim_scratch_owner = animId THEN amg_anim_scratch_owner_valid = 0
    END IF

    AmgAnimItems(animId).Used = 0
    AmgAnimItems(animId).WidthPx = 0
    AmgAnimItems(animId).HeightPx = 0
    AmgAnimItems(animId).FrameStart = 0
    AmgAnimItems(animId).FrameCount = 0
    AmgAnimItems(animId).CurrentFrame = 0
    AmgAnimItems(animId).Playing = 0
    AmgAnimItems(animId).Paused = 0
    AmgAnimItems(animId).LoopMode = AMG_ANIM_LOOP_FILE_DEFAULT
    AmgAnimItems(animId).NextTick = 0
    AmgAnimItems(animId).RemainingDelay = 0
    AmgAnimItems(animId).LastRawTimer = 0
    IF _MEMEXISTS(AmgAnimCanvasMem(animId)) THEN _MEMFREE AmgAnimCanvasMem(animId)
    IF AmgAnimItems(animId).CanvasImage <= -2 THEN _FREEIMAGE AmgAnimItems(animId).CanvasImage: AmgAnimItems(animId).CanvasImage = 0
    AmgAnimItems(animId).RenderedFrame = -1
    AmgAnimItems(animId).DecodedFrame = -1
    AmgAnimItems(animId).ShownIsA = -1
    AmgAnimItems(animId).WorkReady = 0
    AmgAnimItems(animId).FileDataStart = 0
    AmgAnimItems(animId).FileDataSize = 0
    AmgAnimItems(animId).NPlanes = 0
    AmgAnimItems(animId).RowBytes = 0
    AmgAnimItems(animId).PlaneSize = 0
    AmgAnimItems(animId).Compression = 0
    AmgAnimItems(animId).Camg = 0
    AmgAnimItems(animId).IsHam = 0
    AmgAnimItems(animId).PalCount = 0
    AmgAnimItems(animId).PalStart = 0
    AmgAnimItems(animId).WorkBaseStart = 0
    AmgAnimItems(animId).WorkAStart = 0
    AmgAnimItems(animId).WorkBStart = 0
    AmgAnimItems(animId).ChunkyStart = 0
    AmgAnimItems(animId).PixelsStart = 0
    AmgAnimItems(animId).SnapshotMetaStart = 0
    AmgAnimItems(animId).SnapshotCount = 0
    AmgAnimItems(animId).SnapshotInterval = 0
    AmgAnimItems(animId).SnapshotPlanarAStart = 0
    AmgAnimItems(animId).SnapshotPlanarBStart = 0
    AmgAnimItems(animId).SnapshotPaletteStart = 0
    AmgAnimFileNames(animId) = ""
    AmgAnimErrorTexts(animId) = ""
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation set error.
' Parameters: animId = working value for animation id; textValue = working value for text value.
SUB AmgAnimSetError (animId AS LONG, textValue AS STRING)
    IF animId < 0 THEN EXIT SUB
    IF animId > UBOUND(AmgAnimErrorTexts) THEN EXIT SUB
    AmgAnimErrorTexts(animId) = textValue
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation append frame block.
' Parameters: frameCount = total number of frames available for the current animation.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimAppendFrameBlock& (frameCount AS LONG)
    ' Variable: startIndex stores the index variable used to address the current item.
    DIM startIndex AS LONG
    ' Variable: neededTop stores the working value for needed top.
    DIM neededTop AS LONG

    AmgAnimAppendFrameBlock = -1
    IF frameCount <= 0 THEN EXIT FUNCTION

    startIndex = AmgAnimFrameCountUsed
    neededTop = startIndex + frameCount - 1

    IF neededTop > UBOUND(AmgAnimFrames) THEN
        ' dynamic array: AmgAnimFrames is resized here to hold the dynamic array that stores per-frame data or cached frame metadata.
        REDIM _PRESERVE AmgAnimFrames(0 TO neededTop) AS AmgAnimFrameInfo
    END IF

    AmgAnimFrameCountUsed = startIndex + frameCount
    AmgAnimAppendFrameBlock = startIndex
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation count snapshots.
' Parameters: frameCount = total number of frames available for the current animation; intervalValue = working value for interval value.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimCountSnapshots& (frameCount AS LONG, intervalValue AS LONG)
    IF frameCount <= 0 THEN
        AmgAnimCountSnapshots = 0
        EXIT FUNCTION
    END IF
    IF intervalValue <= 0 THEN intervalValue = 1
    AmgAnimCountSnapshots = ((frameCount - 1) \ intervalValue) + 1
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation alloc snapshot meta block.
' Parameters: snapshotCount = count used to size or iterate the current data set.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimAllocSnapshotMetaBlock& (snapshotCount AS LONG)
    ' Variable: startIndex stores the index variable used to address the current item.
    DIM startIndex AS LONG
    ' Variable: neededTop stores the working value for needed top.
    DIM neededTop AS LONG
    ' Variable: indexValue stores the working value for index value.
    DIM indexValue AS LONG

    AmgAnimAllocSnapshotMetaBlock = -1
    IF snapshotCount <= 0 THEN
        AmgAnimAllocSnapshotMetaBlock = 0
        EXIT FUNCTION
    END IF

    startIndex = AmgAnimSnapshotMetaUsed
    neededTop = startIndex + snapshotCount - 1
    IF neededTop > UBOUND(AmgAnimSnapshotMeta) THEN
        ' dynamic array: AmgAnimSnapshotMeta is resized here to hold the working value for Amiga animation snapshot meta.
        REDIM _PRESERVE AmgAnimSnapshotMeta(0 TO neededTop) AS AmgAnimSnapshotStore
    END IF

    ' Loop purpose: use indexValue as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR indexValue = 0 TO snapshotCount - 1
        AmgAnimSnapshotMeta(startIndex + indexValue).Used = 0
        AmgAnimSnapshotMeta(startIndex + indexValue).FrameIndex = -1
        AmgAnimSnapshotMeta(startIndex + indexValue).ShownIsA = -1
    NEXT indexValue

    AmgAnimSnapshotMetaUsed = startIndex + snapshotCount
    AmgAnimAllocSnapshotMetaBlock = startIndex
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation snapshot slot index.
' Parameters: animId = working value for animation id; frameIndex = index variable used to address the current item.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimSnapshotSlotIndex& (animId AS LONG, frameIndex AS LONG)
    ' Variable: intervalValue stores the working value for interval value.
    DIM intervalValue AS LONG
    ' Variable: slotOffset stores the working value for slot offset.
    DIM slotOffset AS LONG

    AmgAnimSnapshotSlotIndex = -1
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION
    IF frameIndex < 0 THEN EXIT FUNCTION
    intervalValue = AmgAnimItems(animId).SnapshotInterval
    IF intervalValue <= 0 THEN EXIT FUNCTION
    IF frameIndex MOD intervalValue <> 0 THEN EXIT FUNCTION
    slotOffset = frameIndex \ intervalValue
    IF slotOffset < 0 THEN EXIT FUNCTION
    IF slotOffset >= AmgAnimItems(animId).SnapshotCount THEN EXIT FUNCTION
    AmgAnimSnapshotSlotIndex = AmgAnimItems(animId).SnapshotMetaStart + slotOffset
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation maybe store snapshot.
' Parameters: animId = working value for animation id; frameIndex = index variable used to address the current item.
SUB AmgAnimMaybeStoreSnapshot (animId AS LONG, frameIndex AS LONG)
    ' Variable: snapshotSlot stores the slot number inside the module-wide storage arrays.
    DIM snapshotSlot AS LONG
    ' Variable: slotOffset stores the working value for slot offset.
    DIM slotOffset AS LONG
    ' Variable: totalPlanar stores the working value for total planar.
    DIM totalPlanar AS LONG
    ' Variable: paletteStart stores the palette storage or palette index used during indexed-color decoding.
    DIM paletteStart AS LONG
    ' Variable: planarAStart stores the working value for planar a start.
    DIM planarAStart AS LONG
    ' Variable: planarBStart stores the working value for planar b start.
    DIM planarBStart AS LONG

    IF AmgAnimValidId(animId) = 0 THEN EXIT SUB
    IF AmgAnimItems(animId).SnapshotCount <= 0 THEN EXIT SUB
    snapshotSlot = AmgAnimSnapshotSlotIndex(animId, frameIndex)
    IF snapshotSlot < 0 THEN EXIT SUB
    IF AmgAnimSnapshotMeta(snapshotSlot).Used THEN EXIT SUB

    slotOffset = snapshotSlot - AmgAnimItems(animId).SnapshotMetaStart
    totalPlanar = AmgAnimItems(animId).RowBytes * AmgAnimItems(animId).HeightPx * AmgAnimItems(animId).NPlanes
    planarAStart = AmgAnimItems(animId).SnapshotPlanarAStart + slotOffset * totalPlanar
    planarBStart = AmgAnimItems(animId).SnapshotPlanarBStart + slotOffset * totalPlanar
    paletteStart = AmgAnimItems(animId).SnapshotPaletteStart + slotOffset * AmgAnimItems(animId).PalCount

    CALL AmgAnimCopyLocalPlanarToPool(amg_anim_scratch_planar_a(), planarAStart, totalPlanar)
    CALL AmgAnimCopyLocalPlanarToPool(amg_anim_scratch_planar_b(), planarBStart, totalPlanar)
    CALL AmgAnimCopyLocalPaletteToPool(amg_anim_scratch_pal(), paletteStart, AmgAnimItems(animId).PalCount)

    AmgAnimSnapshotMeta(snapshotSlot).Used = -1
    AmgAnimSnapshotMeta(snapshotSlot).FrameIndex = frameIndex
    AmgAnimSnapshotMeta(snapshotSlot).ShownIsA = AmgAnimItems(animId).ShownIsA
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation restore nearest snapshot.
' Parameters: animId = working value for animation id; frameIndex = index variable used to address the current item; anim = working value for animation; pal = working value for pal; restoredFrame = working value for restored frame.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimRestoreNearestSnapshot% (animId AS LONG, frameIndex AS LONG, anim AS AmgAnimInfo, pal() AS AmgAnimRGB8, restoredFrame AS LONG)
    ' Variable: intervalValue stores the working value for interval value.
    DIM intervalValue AS LONG
    ' Variable: slotOffset stores the working value for slot offset.
    DIM slotOffset AS LONG
    ' Variable: snapshotSlot stores the slot number inside the module-wide storage arrays.
    DIM snapshotSlot AS LONG
    ' Variable: totalPlanar stores the working value for total planar.
    DIM totalPlanar AS LONG
    ' Variable: paletteStart stores the palette storage or palette index used during indexed-color decoding.
    DIM paletteStart AS LONG
    ' Variable: planarAStart stores the working value for planar a start.
    DIM planarAStart AS LONG
    ' Variable: planarBStart stores the working value for planar b start.
    DIM planarBStart AS LONG

    AmgAnimRestoreNearestSnapshot = 0
    restoredFrame = -1
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION
    IF frameIndex < 0 THEN EXIT FUNCTION
    IF AmgAnimItems(animId).SnapshotCount <= 0 THEN EXIT FUNCTION

    intervalValue = AmgAnimItems(animId).SnapshotInterval
    IF intervalValue <= 0 THEN EXIT FUNCTION

    totalPlanar = anim.rowBytes * anim.h * anim.nPlanes
    slotOffset = frameIndex \ intervalValue
    IF slotOffset >= AmgAnimItems(animId).SnapshotCount THEN slotOffset = AmgAnimItems(animId).SnapshotCount - 1

    ' Loop purpose: keep processing until the controlling condition becomes false, usually while input or timing remains active.
    DO WHILE slotOffset >= 0
        snapshotSlot = AmgAnimItems(animId).SnapshotMetaStart + slotOffset
        IF AmgAnimSnapshotMeta(snapshotSlot).Used THEN
            planarAStart = AmgAnimItems(animId).SnapshotPlanarAStart + slotOffset * totalPlanar
            planarBStart = AmgAnimItems(animId).SnapshotPlanarBStart + slotOffset * totalPlanar
            paletteStart = AmgAnimItems(animId).SnapshotPaletteStart + slotOffset * AmgAnimItems(animId).PalCount

            CALL AmgAnimCopyPoolPlanarToLocal(planarAStart, totalPlanar, amg_anim_scratch_planar_a())
            CALL AmgAnimCopyPoolPlanarToLocal(planarBStart, totalPlanar, amg_anim_scratch_planar_b())
            CALL AmgAnimCopyPoolPaletteToLocal(paletteStart, AmgAnimItems(animId).PalCount, pal())
            CALL AmgAnimCopyLocalPaletteToScratch(pal())

            amg_anim_scratch_owner = animId
            amg_anim_scratch_owner_valid = -1
            AmgAnimItems(animId).ShownIsA = AmgAnimSnapshotMeta(snapshotSlot).ShownIsA
            AmgAnimItems(animId).DecodedFrame = AmgAnimSnapshotMeta(snapshotSlot).FrameIndex
            AmgAnimItems(animId).WorkReady = -1
            restoredFrame = AmgAnimItems(animId).DecodedFrame
            AmgAnimRestoreNearestSnapshot = -1
            EXIT FUNCTION
        END IF
        slotOffset = slotOffset - 1
    LOOP
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation valid id.
' Parameters: animId = working value for animation id.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimValidId% (animId AS LONG)
    AmgAnimValidId = 0
    IF animId < 0 THEN EXIT FUNCTION
    IF animId > UBOUND(AmgAnimItems) THEN EXIT FUNCTION
    IF AmgAnimItems(animId).Used = 0 THEN EXIT FUNCTION
    IF LEN(AmgAnimFileNames(animId)) = 0 THEN EXIT FUNCTION
    AmgAnimValidId = -1
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation frame delay ticks.
' Parameters: animId = working value for animation id; frameIndex = index variable used to address the current item.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimFrameDelayTicks& (animId AS LONG, frameIndex AS LONG)
    ' Variable: delayTicks stores the frame delay or timing value.
    DIM delayTicks AS LONG
    ' Variable: frameSlot stores the slot number inside the module-wide storage arrays.
    DIM frameSlot AS LONG

    delayTicks = 0
    frameSlot = AmgAnimItems(animId).FrameStart + frameIndex
    IF frameSlot >= 0 AND frameSlot <= UBOUND(AmgAnimFrames) THEN
        IF AmgAnimFrames(frameSlot).hasANHD THEN
            delayTicks = AmgAnimFrames(frameSlot).reltime
        END IF
    END IF

    IF delayTicks <= 0 THEN
        IF frameIndex = 0 THEN
            delayTicks = AMG_ANIM_DEFAULT_FIRST_DELAY_TICKS
        ELSE
            delayTicks = 1
        END IF
    END IF

    AmgAnimFrameDelayTicks = delayTicks
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation frame delay sec.
' Parameters: animId = working value for animation id; frameIndex = index variable used to address the current item.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimFrameDelaySec# (animId AS LONG, frameIndex AS LONG)
    ' Variable: delaySec stores the frame delay or timing value.
    DIM delaySec AS DOUBLE

    delaySec = AmgAnimFrameDelayTicks(animId, frameIndex) / 60#
    delaySec = delaySec * 2 'too fast (specification says something else, but....)
    IF delaySec <= 0 THEN delaySec = 1# / 60#
    AmgAnimFrameDelaySec = delaySec
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation ensure frame rendered.
' Parameters: animId = working value for animation id; frameIndex = index variable used to address the current item.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimEnsureFrameRendered% (animId AS LONG, frameIndex AS LONG)
    AmgAnimEnsureFrameRendered = 0
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION
    IF frameIndex < 0 THEN EXIT FUNCTION
    IF frameIndex >= AmgAnimItems(animId).FrameCount THEN EXIT FUNCTION

    IF AmgAnimItems(animId).RenderedFrame = frameIndex THEN
        IF AmgAnimItems(animId).CanvasImage <= -2 THEN
            AmgAnimEnsureFrameRendered = -1
            EXIT FUNCTION
        END IF
    END IF

    IF AmgAnimItems(animId).CanvasImage > -2 THEN EXIT FUNCTION

    IF AmgAnimRenderFrameToCanvas(animId, frameIndex) = 0 THEN
        AmgAnimSetError animId, "AmgAnimEnsureFrameRendered: frame render failed"
        EXIT FUNCTION
    END IF

    AmgAnimItems(animId).RenderedFrame = frameIndex
    AmgAnimEnsureFrameRendered = -1
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation time add.
' Parameters: baseTime = time-related value used by the current routine; deltaSec = working value for delta sec.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimTimeAdd# (baseTime AS DOUBLE, deltaSec AS DOUBLE)
    ' Variable: resultTime stores the time-related value used by the current routine.
    DIM resultTime AS DOUBLE

    resultTime = baseTime + deltaSec
    IF resultTime >= 86400# THEN resultTime = resultTime - 86400#

    AmgAnimTimeAdd = resultTime
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation time reached.
' Parameters: targetTime = time-related value used by the current routine; currentTime = time-related value used by the current routine.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimTimeReached% (targetTime AS DOUBLE, currentTime AS DOUBLE)
    AmgAnimTimeReached = 0

    IF ABS(currentTime - targetTime) < 43200# THEN
        IF currentTime >= targetTime THEN AmgAnimTimeReached = -1
    ELSE
        IF currentTime < targetTime THEN AmgAnimTimeReached = -1
    END IF
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation time remaining.
' Parameters: targetTime = time-related value used by the current routine; currentTime = time-related value used by the current routine.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimTimeRemaining# (targetTime AS DOUBLE, currentTime AS DOUBLE)
    ' Variable: resultTime stores the time-related value used by the current routine.
    DIM resultTime AS DOUBLE

    resultTime = targetTime - currentTime
    IF resultTime < 0 THEN resultTime = resultTime + 86400#
    IF AmgAnimTimeReached(targetTime, currentTime) THEN resultTime = 0

    AmgAnimTimeRemaining = resultTime
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation alloc data block.
' Parameters: byteCount = count used to size or iterate the current data set.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimAllocDataBlock& (byteCount AS LONG)
    ' Variable: startIndex stores the index variable used to address the current item.
    DIM startIndex AS LONG
    ' Variable: neededTop stores the working value for needed top.
    DIM neededTop AS LONG

    AmgAnimAllocDataBlock = -1
    IF byteCount <= 0 THEN EXIT FUNCTION

    startIndex = amg_anim_data_pool_used
    neededTop = startIndex + byteCount - 1

    IF neededTop > UBOUND(amg_anim_data_pool) THEN
        ' dynamic array: amg_anim_data_pool is resized here to hold the buffer that holds raw, packed, or decoded byte data.
        REDIM _PRESERVE amg_anim_data_pool(0 TO neededTop) AS _UNSIGNED _BYTE
    END IF

    amg_anim_data_pool_used = startIndex + byteCount
    AmgAnimAllocDataBlock = startIndex
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation copy scratch to data pool.
' Parameters: dstStart = working value for dst start; byteCount = count used to size or iterate the current data set.
SUB AmgAnimCopyScratchToDataPool (dstStart AS LONG, byteCount AS LONG)
    ' Variable: dataMem stores the buffer that holds raw, packed, or decoded byte data.
    DIM dataMem AS _MEM

    IF dstStart < 0 THEN EXIT SUB
    IF byteCount <= 0 THEN EXIT SUB
    IF byteCount > amg_anim_file_size THEN EXIT SUB

    dataMem = _MEM(amg_anim_data_pool())
    _MEMPUT dataMem, dataMem.OFFSET + dstStart, amg_anim_buf()
    IF _MEMEXISTS(dataMem) THEN _MEMFREE dataMem
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation use scratch buffer.
SUB AmgAnimUseScratchBuffer ()
    amg_anim_active_mode = 0
    amg_anim_active_pool_ofs = 0
    amg_anim_active_pool_size = 0
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation use slot buffer.
' Parameters: animId = working value for animation id.
SUB AmgAnimUseSlotBuffer (animId AS LONG)
    IF AmgAnimValidId(animId) = 0 THEN EXIT SUB

    amg_anim_active_mode = 1
    amg_anim_active_pool_ofs = AmgAnimItems(animId).FileDataStart
    amg_anim_active_pool_size = AmgAnimItems(animId).FileDataSize
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation active size.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimActiveSize& ()
    IF amg_anim_active_mode = 1 THEN
        AmgAnimActiveSize = amg_anim_active_pool_size
    ELSE
        AmgAnimActiveSize = amg_anim_file_size
    END IF
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation get active byte.
' Parameters: ofs = current offset into packed or unpacked data.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimGetActiveByte& (ofs AS _UNSIGNED _INTEGER64)
    AmgAnimGetActiveByte = 0

    IF amg_anim_active_mode = 1 THEN
        IF amg_anim_active_pool_size <= 0 THEN EXIT FUNCTION
        IF ofs > amg_anim_active_pool_size - 1 THEN EXIT FUNCTION
        AmgAnimGetActiveByte = amg_anim_data_pool(amg_anim_active_pool_ofs + ofs)
    ELSE
        IF amg_anim_file_size <= 0 THEN EXIT FUNCTION
        IF ofs > amg_anim_file_size - 1 THEN EXIT FUNCTION
        AmgAnimGetActiveByte = amg_anim_buf(ofs)
    END IF
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation alloc data block size.
' Parameters: dataStart = buffer that holds raw, packed, or decoded byte data.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimAllocDataBlockSize& (dataStart AS LONG)
    ' Variable: dataTop stores the buffer that holds raw, packed, or decoded byte data.
    DIM dataTop AS LONG

    AmgAnimAllocDataBlockSize = 0
    IF dataStart < 0 THEN EXIT FUNCTION
    dataTop = amg_anim_data_pool_used - 1
    IF dataStart > dataTop THEN EXIT FUNCTION
    AmgAnimAllocDataBlockSize = dataTop - dataStart + 1
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation load file to data pool.
' Parameters: fileName = string holding a file path or a human-readable name; ok = success flag returned by the current routine.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimLoadFileToDataPool& (fileName AS STRING, ok AS LONG)
    ' Variable: fh stores the working value for fh.
    DIM fh AS LONG
    ' Variable: fileLen stores the working value for file len.
    DIM fileLen AS LONG
    ' Variable: dataStart stores the buffer that holds raw, packed, or decoded byte data.
    DIM dataStart AS LONG
    ' Variable: chunkSize stores the size of the current chunk payload.
    DIM chunkSize AS LONG
    ' Variable: readPos stores the working value for read pos.
    DIM readPos AS LONG
    ' Variable: bytesLeft stores the working value for bytes left.
    DIM bytesLeft AS LONG
    ' Variable: writeOfs stores the working value for write ofs.
    DIM writeOfs AS LONG
    ' Variable: dataMem stores the buffer that holds raw, packed, or decoded byte data.
    DIM dataMem AS _MEM

    ' dynamic array: ioBuf is resized here to hold the buffer that holds raw, packed, or decoded byte data.
    REDIM ioBuf(0 TO 0) AS _UNSIGNED _BYTE
    ' dynamic array: tailBuf is resized here to hold the buffer that holds raw, packed, or decoded byte data.
    REDIM tailBuf(0 TO 0) AS _UNSIGNED _BYTE

    ok = 0
    AmgAnimLoadFileToDataPool = -1
    IF _FILEEXISTS(fileName) = 0 THEN EXIT FUNCTION

    fh = FREEFILE
    OPEN fileName FOR BINARY AS #fh

    fileLen = LOF(fh)
    IF fileLen <= 0 THEN
        CLOSE #fh
        EXIT FUNCTION
    END IF

    dataStart = AmgAnimAllocDataBlock(fileLen)
    IF dataStart < 0 THEN
        CLOSE #fh
        EXIT FUNCTION
    END IF

    chunkSize = 262144
    IF fileLen < chunkSize THEN chunkSize = fileLen
    ' dynamic array: ioBuf is resized here to hold the buffer that holds raw, packed, or decoded byte data.
    REDIM ioBuf(0 TO chunkSize - 1) AS _UNSIGNED _BYTE

    dataMem = _MEM(amg_anim_data_pool())
    readPos = 0
    writeOfs = dataStart
    bytesLeft = fileLen

    ' Loop purpose: keep processing until the controlling condition becomes false, usually while input or timing remains active.
    DO WHILE bytesLeft >= chunkSize AND chunkSize > 0
        GET #fh, readPos + 1, ioBuf()
        _MEMPUT dataMem, dataMem.OFFSET + writeOfs, ioBuf()
        readPos = readPos + chunkSize
        writeOfs = writeOfs + chunkSize
        bytesLeft = bytesLeft - chunkSize
    LOOP

    IF bytesLeft > 0 THEN
        ' dynamic array: tailBuf is resized here to hold the buffer that holds raw, packed, or decoded byte data.
        REDIM tailBuf(0 TO bytesLeft - 1) AS _UNSIGNED _BYTE
        GET #fh, readPos + 1, tailBuf()
        _MEMPUT dataMem, dataMem.OFFSET + writeOfs, tailBuf()
    END IF

    IF _MEMEXISTS(dataMem) THEN _MEMFREE dataMem
    CLOSE #fh

    AmgAnimLoadFileToDataPool = dataStart
    ok = -1
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation load file to buffer.
' Parameters: fileName = string holding a file path or a human-readable name; ok = success flag returned by the current routine.
SUB AmgAnimLoadFileToBuffer (fileName AS STRING, ok AS LONG)
    ' Variable: fh stores the working value for fh.
    DIM fh AS LONG
    ' Variable: fileLen stores the working value for file len.
    DIM fileLen AS LONG

    ok = 0
    IF _FILEEXISTS(fileName) = 0 THEN EXIT SUB
    fh = FREEFILE
    OPEN fileName FOR BINARY AS #fh

    fileLen = LOF(fh)
    IF fileLen <= 0 THEN
        CLOSE #fh
        '         Print "File is empty."
        EXIT SUB
    END IF

    amg_anim_file_size = fileLen
    ' dynamic array: amg_anim_buf is resized here to hold the buffer that holds raw, packed, or decoded byte data.
    REDIM amg_anim_buf(0 TO amg_anim_file_size - 1) AS _UNSIGNED _BYTE
    GET #fh, 1, amg_anim_buf()
    CLOSE #fh

    AmgAnimUseScratchBuffer
    ok = -1
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation load index.
' Parameters: anim = working value for animation; frames = dynamic array that stores per-frame data or cached frame metadata; pal = working value for pal.
SUB AmgAnimLoadIndex (anim AS AmgAnimInfo, frames() AS AmgAnimFrameInfo, pal() AS AmgAnimRGB8)
    ' Variable: bufOfs stores the working value for buf ofs.
    DIM bufOfs AS _UNSIGNED _INTEGER64
    ' Variable: topId stores the working value for top id.
    DIM topId AS STRING
    ' Variable: formSize stores the working value for form size.
    DIM formSize AS _UNSIGNED LONG
    ' Variable: formType stores the working value for form type.
    DIM formType AS STRING
    ' Variable: formDataOfs stores the buffer that holds raw, packed, or decoded byte data.
    DIM formDataOfs AS _UNSIGNED _INTEGER64

    bufOfs = 0
    topId = AmgAnimReadIDFromBuf$(bufOfs)

    IF topId <> "FORM" THEN
        '         Print "Not an IFF FORM."; topId
        EXIT SUB
    END IF

    CALL AmgAnimReadU32BE(bufOfs, formSize)
    formType = AmgAnimReadIDFromBuf$(bufOfs)
    formDataOfs = bufOfs

    IF formType <> "ANIM" THEN
        '         Print "Not FORM ANIM."
        EXIT SUB
    END IF

    ' Start with an empty frame array and grow it while scanning.
    ' This avoids a full extra pass through the file just to count frames.
    REDIM frames(0 TO 0) AS AmgAnimFrameInfo
    CALL AmgAnimScanAnimFormGrow(formDataOfs, formSize - 4, anim, frames(), pal())
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation scan animation form.
' Parameters: formDataOfs = buffer that holds raw, packed, or decoded byte data; formSize = working value for form size; anim = working value for animation; frames = dynamic array that stores per-frame data or cached frame metadata; pal = working value for pal.
SUB AmgAnimScanAnimFormGrow (formDataOfs AS _UNSIGNED _INTEGER64, formSize AS _UNSIGNED LONG, anim AS AmgAnimInfo, frames() AS AmgAnimFrameInfo, pal() AS AmgAnimRGB8)
    ' Variable: formEnd stores the working value for form end.
    DIM formEnd AS _UNSIGNED _INTEGER64
    ' Variable: bufOfs stores the working value for buf ofs.
    DIM bufOfs AS _UNSIGNED _INTEGER64
    ' Variable: subPos stores the working value for sub pos.
    DIM subPos AS _UNSIGNED _INTEGER64
    ' Variable: ck stores the working value for ck.
    DIM ck AS AmgAnimIffChunkInfo
    ' Variable: ok stores the success flag returned by the current routine.
    DIM ok AS LONG
    ' Variable: subType stores the working value for sub type.
    DIM subType AS STRING
    ' Variable: frameIndex stores the index variable used to address the current item.
    DIM frameIndex AS LONG
    ' Variable: frameCapacity stores the current allocated frame capacity.
    DIM frameCapacity AS LONG
    ' Variable: newCapacity stores the next allocated frame capacity.
    DIM newCapacity AS LONG

    formEnd = formDataOfs + formSize
    frameIndex = -1
    frameCapacity = 0
    bufOfs = formDataOfs

    DO WHILE bufOfs < formEnd
        CALL AmgAnimReadIffChunk(bufOfs, formEnd, ck, ok)
        IF ok = 0 THEN EXIT DO

        IF ck.id = "FORM" THEN
            subPos = ck.dataOfs
            subType = AmgAnimReadIDFromBuf$(subPos)

            IF subType = "ILBM" THEN
                frameIndex = frameIndex + 1

                IF frameIndex > frameCapacity THEN
                    IF frameCapacity <= 0 THEN
                        newCapacity = 15
                    ELSE
                        newCapacity = frameCapacity * 2 + 1
                    END IF
                    REDIM _PRESERVE frames(0 TO newCapacity) AS AmgAnimFrameInfo
                    frameCapacity = newCapacity
                END IF

                frames(frameIndex).fileOfs = ck.dataOfs - 8
                frames(frameIndex).formSize = ck.size
                CALL AmgAnimScanIlbmFrame(ck.dataOfs + 4, ck.size - 4, frameIndex, anim, frames(frameIndex), pal())
            END IF
        END IF

        bufOfs = ck.nextOfs
    LOOP

    IF frameIndex >= 0 THEN
        anim.frameCount = frameIndex + 1
        IF frameIndex < UBOUND(frames) THEN
            REDIM _PRESERVE frames(0 TO frameIndex) AS AmgAnimFrameInfo
        END IF
    ELSE
        anim.frameCount = 0
        REDIM frames(0 TO 0) AS AmgAnimFrameInfo
    END IF
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation count animation frames.
' Parameters: formDataOfs = buffer that holds raw, packed, or decoded byte data; formSize = working value for form size.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimCountAnimFrames& (formDataOfs AS _UNSIGNED _INTEGER64, formSize AS _UNSIGNED LONG)
    ' Variable: formEnd stores the working value for form end.
    DIM formEnd AS _UNSIGNED _INTEGER64
    ' Variable: bufOfs stores the working value for buf ofs.
    DIM bufOfs AS _UNSIGNED _INTEGER64
    ' Variable: subPos stores the working value for sub pos.
    DIM subPos AS _UNSIGNED _INTEGER64
    ' Variable: ck stores the working value for ck.
    DIM ck AS AmgAnimIffChunkInfo
    ' Variable: ok stores the success flag returned by the current routine.
    DIM ok AS LONG
    ' Variable: subType stores the working value for sub type.
    DIM subType AS STRING
    ' Variable: frameCount stores the total number of frames available for the current animation.
    DIM frameCount AS LONG

    frameCount = 0
    formEnd = formDataOfs + formSize
    bufOfs = formDataOfs

    ' Loop purpose: keep processing until the controlling condition becomes false, usually while input or timing remains active.
    DO WHILE bufOfs < formEnd
        CALL AmgAnimReadIffChunk(bufOfs, formEnd, ck, ok)
        IF ok = 0 THEN EXIT DO

        IF ck.id = "FORM" THEN
            subPos = ck.dataOfs
            subType = AmgAnimReadIDFromBuf$(subPos)
            IF subType = "ILBM" THEN frameCount = frameCount + 1
        END IF

        bufOfs = ck.nextOfs
    LOOP

    AmgAnimCountAnimFrames = frameCount
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation scan animation form.
' Parameters: formDataOfs = buffer that holds raw, packed, or decoded byte data; formSize = working value for form size; anim = working value for animation; frames = dynamic array that stores per-frame data or cached frame metadata; pal = working value for pal.
SUB AmgAnimScanAnimForm (formDataOfs AS _UNSIGNED _INTEGER64, formSize AS _UNSIGNED LONG, anim AS AmgAnimInfo, frames() AS AmgAnimFrameInfo, pal() AS AmgAnimRGB8)
    ' Variable: formEnd stores the working value for form end.
    DIM formEnd AS _UNSIGNED _INTEGER64
    ' Variable: bufOfs stores the working value for buf ofs.
    DIM bufOfs AS _UNSIGNED _INTEGER64
    ' Variable: subPos stores the working value for sub pos.
    DIM subPos AS _UNSIGNED _INTEGER64
    ' Variable: ck stores the working value for ck.
    DIM ck AS AmgAnimIffChunkInfo
    ' Variable: ok stores the success flag returned by the current routine.
    DIM ok AS LONG
    ' Variable: subType stores the working value for sub type.
    DIM subType AS STRING
    ' Variable: frameIndex stores the index variable used to address the current item.
    DIM frameIndex AS LONG
    ' Variable: frameTop stores the working value for frame top.
    DIM frameTop AS LONG

    formEnd = formDataOfs + formSize
    frameIndex = -1
    frameTop = UBOUND(frames)
    bufOfs = formDataOfs

    ' Loop purpose: keep processing until the controlling condition becomes false, usually while input or timing remains active.
    DO WHILE bufOfs < formEnd
        CALL AmgAnimReadIffChunk(bufOfs, formEnd, ck, ok)
        IF ok = 0 THEN EXIT DO

        IF ck.id = "FORM" THEN
            subPos = ck.dataOfs
            subType = AmgAnimReadIDFromBuf$(subPos)

            IF subType = "ILBM" THEN
                IF frameIndex < frameTop THEN
                    frameIndex = frameIndex + 1
                    frames(frameIndex).fileOfs = ck.dataOfs - 8
                    frames(frameIndex).formSize = ck.size

                    CALL AmgAnimScanIlbmFrame(ck.dataOfs + 4, ck.size - 4, frameIndex, anim, frames(frameIndex), pal())
                END IF
            END IF
        END IF

        bufOfs = ck.nextOfs
    LOOP

    IF frameIndex >= 0 THEN
        anim.frameCount = frameIndex + 1
    ELSE
        anim.frameCount = 0
    END IF
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation scan ILBM frame.
' Parameters: ilbmDataOfs = buffer that holds raw, packed, or decoded byte data; ilbmSize = working value for ILBM size; frameIndex = index variable used to address the current item; anim = working value for animation; frame = working value for frame; pal = working value for pal.
SUB AmgAnimScanIlbmFrame (ilbmDataOfs AS _UNSIGNED _INTEGER64, ilbmSize AS _UNSIGNED LONG, frameIndex AS LONG, anim AS AmgAnimInfo, frame AS AmgAnimFrameInfo, pal() AS AmgAnimRGB8)
    ' Variable: ilbmEnd stores the working value for ILBM end.
    DIM ilbmEnd AS _UNSIGNED _INTEGER64
    ' Variable: bufOfs stores the working value for buf ofs.
    DIM bufOfs AS _UNSIGNED _INTEGER64
    ' Variable: ck stores the working value for ck.
    DIM ck AS AmgAnimIffChunkInfo
    ' Variable: ok stores the success flag returned by the current routine.
    DIM ok AS LONG
    ' Variable: ilbm stores the working value for ILBM.
    DIM ilbm AS AmgAnimIlbmInfo
    ' Variable: anhd stores the working value for anhd.
    DIM anhd AS AmgAnimAnhdInfo
    ' Variable: okBmhd stores the working value for ok bmhd.
    DIM okBmhd AS LONG
    ' Variable: okAnhd stores the working value for ok anhd.
    DIM okAnhd AS LONG

    ilbmEnd = ilbmDataOfs + ilbmSize
    bufOfs = ilbmDataOfs

    ' Loop purpose: keep processing until the controlling condition becomes false, usually while input or timing remains active.
    DO WHILE bufOfs < ilbmEnd
        CALL AmgAnimReadIffChunk(bufOfs, ilbmEnd, ck, ok)
        IF ok = 0 THEN EXIT DO

        SELECT CASE ck.id
            CASE "BMHD"
                frame.hasBMHD = -1
                frame.bmhdOfs = ck.dataOfs

                IF frameIndex = 0 THEN
                    CALL AmgAnimReadBMHDAt(ck.dataOfs, ilbm)
                    CALL AmgAnimValidateFirstFrameBMHD(ilbm, okBmhd)
                    IF okBmhd = 0 THEN EXIT SUB

                    anim.w = ilbm.w
                    anim.h = ilbm.h
                    anim.nPlanes = ilbm.nPlanes
                    anim.rowBytes = ilbm.rowBytes
                    anim.planeSize = ilbm.planeSize
                    anim.compression = ilbm.compression
                    anim.firstFrameReady = -1
                END IF

            CASE "CMAP"
                frame.hasCMAP = -1
                frame.cmapOfs = ck.dataOfs
                frame.cmapSize = ck.size

                IF frameIndex = 0 THEN
                    CALL AmgAnimReadCMAPAt(ck.dataOfs, ck.size, pal())
                END IF

            CASE "CAMG"
                IF frameIndex = 0 THEN
                    CALL AmgAnimReadCAMGAt(ck.dataOfs, anim.camg)
                    IF (anim.camg AND &H800) <> 0 THEN
                        anim.isHAM = -1
                    ELSE
                        anim.isHAM = 0
                    END IF
                END IF

            CASE "BODY"
                frame.hasBODY = -1
                frame.bodyOfs = ck.dataOfs
                frame.bodySize = ck.size

            CASE "ANHD"
                frame.hasANHD = -1
                frame.anhdOfs = ck.dataOfs
                CALL AmgAnimReadANHDAt(ck.dataOfs, anhd)
                CALL AmgAnimValidateFrameANHD(anhd, okAnhd)
                IF okAnhd = 0 THEN EXIT SUB

                frame.opCode = anhd.operation
                frame.reltime = anhd.reltime
                frame.interleave = anhd.interleave
                frame.anhdBits = anhd.bits

            CASE "DLTA"
                frame.hasDLTA = -1
                frame.dltaOfs = ck.dataOfs
                frame.dltaSize = ck.size
        END SELECT

        bufOfs = ck.nextOfs
    LOOP
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation load first frame planar.
' Parameters: anim = working value for animation; frame = working value for frame; planarBase = working value for planar base; planarWork = working value for planar work; pal = working value for pal.
SUB AmgAnimLoadFirstFramePlanar (anim AS AmgAnimInfo, frame AS AmgAnimFrameInfo, planarBase() AS _UNSIGNED _BYTE, planarWork() AS _UNSIGNED _BYTE, pal() AS AmgAnimRGB8)
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG
    ' Variable: totalPlanar stores the working value for total planar.
    DIM totalPlanar AS LONG

    IF frame.hasBMHD = 0 THEN
        '         Print "Frame 0 missing BMHD."
        EXIT SUB
    END IF

    IF frame.hasBODY = 0 AND frame.hasDLTA = 0 THEN
        '         Print "Frame 0 missing BODY or DLTA."
        EXIT SUB
    END IF

    totalPlanar = anim.rowBytes * anim.h * anim.nPlanes

    IF frame.hasCMAP THEN
        CALL AmgAnimReadCMAPAt(frame.cmapOfs, frame.cmapSize, pal())
    END IF

    ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 0 TO totalPlanar - 1
        planarBase(i) = 0
    NEXT i

    IF frame.hasBODY THEN
        CALL AmgAnimDecodeILBMBodyToPlanar(anim, frame.bodyOfs, frame.bodySize, anim.compression, planarBase())
    ELSEIF frame.hasDLTA AND frame.opCode = 7 THEN
        CALL AmgAnimApplyDLTAOp7(anim, frame.dltaOfs, frame.dltaSize, frame.anhdBits, planarBase())
    ELSE
        '         Print "Frame 0 uses unsupported data layout."
        EXIT SUB
    END IF

    ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 0 TO totalPlanar - 1
        planarWork(i) = planarBase(i)
    NEXT
END SUB

' Purpose: Decode or apply Amiga ANIM delta/frame data to the current bitmap.
' Parameters: anim = working value for animation; frame = working value for frame; shownPlanar = working value for shown planar; hiddenPlanar = working value for hidden planar; pal = working value for pal.
SUB AmgAnimDecodeFrameToHidden (anim AS AmgAnimInfo, frame AS AmgAnimFrameInfo, hiddenPlanar() AS _UNSIGNED _BYTE, pal() AS AmgAnimRGB8)
    IF frame.hasCMAP THEN
        CALL AmgAnimReadCMAPAt(frame.cmapOfs, frame.cmapSize, pal())
    END IF

    SELECT CASE frame.opCode
        CASE 0
            CALL AmgAnimDecodeILBMBodyToPlanar(anim, frame.bodyOfs, frame.bodySize, anim.compression, hiddenPlanar())
        CASE 5
            CALL AmgAnimApplyDLTAOp5(anim, frame.dltaOfs, frame.dltaSize, hiddenPlanar())
        CASE 7
            CALL AmgAnimApplyDLTAOp7(anim, frame.dltaOfs, frame.dltaSize, frame.anhdBits, hiddenPlanar())
        CASE ELSE
            '             Print "Unsupported opCode:"; frame.opCode
    END SELECT
END SUB

' Purpose: Read IFF/ANIM chunks and build decoder state for the Amiga animation.
' Parameters: ofs = current offset into packed or unpacked data; ilbm = working value for ILBM.
SUB AmgAnimReadBMHDAt (ofs AS _UNSIGNED _INTEGER64, ilbm AS AmgAnimIlbmInfo)
    ' Variable: bufOfs stores the working value for buf ofs.
    DIM bufOfs AS _UNSIGNED _INTEGER64
    ' Variable: b stores the color component or packed color helper used during image conversion.
    DIM b AS _UNSIGNED _BYTE

    bufOfs = ofs

    CALL AmgAnimReadU16BE(bufOfs, ilbm.w)
    CALL AmgAnimReadU16BE(bufOfs, ilbm.h)
    CALL AmgAnimReadS16BE(bufOfs, ilbm.x)
    CALL AmgAnimReadS16BE(bufOfs, ilbm.y)

    CALL AmgAnimReadByte(bufOfs, b)
    ilbm.nPlanes = b

    CALL AmgAnimReadByte(bufOfs, b)
    ilbm.masking = b

    CALL AmgAnimReadByte(bufOfs, b)
    ilbm.compression = b

    CALL AmgAnimReadByte(bufOfs, b)

    CALL AmgAnimReadU16BE(bufOfs, ilbm.transparentColor)

    CALL AmgAnimReadByte(bufOfs, b)
    ilbm.xAspect = b

    CALL AmgAnimReadByte(bufOfs, b)
    ilbm.yAspect = b

    CALL AmgAnimReadS16BE(bufOfs, ilbm.pageWidth)
    CALL AmgAnimReadS16BE(bufOfs, ilbm.pageHeight)

    ilbm.rowBytes = ((ilbm.w + 15) \ 16) * 2
    ilbm.planeSize = ilbm.rowBytes * ilbm.h
    ilbm.hasBMHD = -1
END SUB

' Purpose: Read IFF/ANIM chunks and build decoder state for the Amiga animation.
' Parameters: ofs = current offset into packed or unpacked data; size = size value for the current block, buffer, or file; pal = working value for pal.
SUB AmgAnimReadCMAPAt (ofs AS _UNSIGNED _INTEGER64, size AS _UNSIGNED LONG, pal() AS AmgAnimRGB8)
    ' Variable: bufOfs stores the working value for buf ofs.
    DIM bufOfs AS _UNSIGNED _INTEGER64
    ' Variable: count stores the count used by the current routine.
    DIM count AS LONG
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG
    ' Variable: b stores the color component or packed color helper used during image conversion.
    DIM b AS _UNSIGNED _BYTE

    count = size \ 3
    IF count <= 0 THEN EXIT SUB

    ' dynamic array: pal is resized here to hold the working value for pal.
    REDIM pal(0 TO count - 1) AS AmgAnimRGB8
    bufOfs = ofs

    ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 0 TO count - 1
        CALL AmgAnimReadByte(bufOfs, b)
        pal(i).r = b

        CALL AmgAnimReadByte(bufOfs, b)
        pal(i).g = b

        CALL AmgAnimReadByte(bufOfs, b)
        pal(i).b = b
    NEXT
END SUB

' Purpose: Read IFF/ANIM chunks and build decoder state for the Amiga animation.
' Parameters: ofs = current offset into packed or unpacked data; anhd = working value for anhd.
SUB AmgAnimReadANHDAt (ofs AS _UNSIGNED _INTEGER64, anhd AS AmgAnimAnhdInfo)
    ' Variable: bufOfs stores the working value for buf ofs.
    DIM bufOfs AS _UNSIGNED _INTEGER64
    ' Variable: b stores the color component or packed color helper used during image conversion.
    DIM b AS _UNSIGNED _BYTE

    bufOfs = ofs

    CALL AmgAnimReadByte(bufOfs, b)
    anhd.operation = b

    CALL AmgAnimReadByte(bufOfs, b)
    anhd.mask = b

    CALL AmgAnimReadU16BE(bufOfs, anhd.w)
    CALL AmgAnimReadU16BE(bufOfs, anhd.h)
    CALL AmgAnimReadS16BE(bufOfs, anhd.x)
    CALL AmgAnimReadS16BE(bufOfs, anhd.y)
    CALL AmgAnimReadU32BE(bufOfs, anhd.abstime)
    CALL AmgAnimReadU32BE(bufOfs, anhd.reltime)

    CALL AmgAnimReadByte(bufOfs, b)
    anhd.interleave = b

    CALL AmgAnimReadByte(bufOfs, b)

    CALL AmgAnimReadU32BE(bufOfs, anhd.bits)

    anhd.valid = -1
END SUB

' Purpose: Read IFF/ANIM chunks and build decoder state for the Amiga animation.
' Parameters: ofs = current offset into packed or unpacked data; camgValue = working value for camg value.
SUB AmgAnimReadCAMGAt (ofs AS _UNSIGNED _INTEGER64, camgValue AS _UNSIGNED LONG)
    camgValue = 0

    IF AmgAnimActiveSize <= 0 THEN EXIT SUB
    IF ofs + 3 > AmgAnimActiveSize - 1 THEN
        '         Print "CAMG chunk truncated."
        EXIT SUB
    END IF

    CALL AmgAnimReadU32BE(ofs, camgValue)
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation planar to chunky.
' Parameters: anim = working value for animation; planar = working value for planar; chunky = working value for chunky.
SUB AmgAnimPlanarToChunky (anim AS AmgAnimInfo, planar() AS _UNSIGNED _BYTE, chunky() AS _UNSIGNED _BYTE)
    ' Variable: y stores the vertical pixel or coordinate index.
    DIM y AS LONG
    ' Variable: xByte stores the working value for x byte.
    DIM xByte AS LONG
    ' Variable: p stores the generic pointer or position value.
    DIM p AS LONG
    ' Variable: rowBase stores the row pointer, row buffer, or row index used for image processing.
    DIM rowBase AS LONG
    ' Array: planeBase stores the working value for plane base.
    DIM planeBase(0 TO 7) AS LONG
    ' Array: pb stores the working value for pb.
    DIM pb(0 TO 7) AS _UNSIGNED _BYTE
    ' Variable: baseX stores the working value for base x.
    DIM baseX AS LONG
    ' Variable: rowPixelBase stores the row pointer, row buffer, or row index used for image processing.
    DIM rowPixelBase AS LONG
    ' Variable: rowPixelLimit stores the row pointer, row buffer, or row index used for image processing.
    DIM rowPixelLimit AS LONG
    ' Variable: color0 stores the column index or color-related value.
    DIM color0 AS LONG
    ' Variable: color1 stores the column index or color-related value.
    DIM color1 AS LONG
    ' Variable: color2 stores the column index or color-related value.
    DIM color2 AS LONG
    ' Variable: color3 stores the column index or color-related value.
    DIM color3 AS LONG
    ' Variable: color4 stores the column index or color-related value.
    DIM color4 AS LONG
    ' Variable: color5 stores the column index or color-related value.
    DIM color5 AS LONG
    ' Variable: color6 stores the column index or color-related value.
    DIM color6 AS LONG
    ' Variable: color7 stores the column index or color-related value.
    DIM color7 AS LONG
    ' Variable: bitValue stores the working value for bit value.
    DIM bitValue AS LONG
    ' Variable: b0 stores the working value for b 0.
    DIM b0 AS _UNSIGNED _BYTE
    ' Variable: b1 stores the working value for b 1.
    DIM b1 AS _UNSIGNED _BYTE
    ' Variable: b2 stores the working value for b 2.
    DIM b2 AS _UNSIGNED _BYTE
    ' Variable: b3 stores the working value for b 3.
    DIM b3 AS _UNSIGNED _BYTE
    ' Variable: b4 stores the working value for b 4.
    DIM b4 AS _UNSIGNED _BYTE
    ' Variable: b5 stores the working value for b 5.
    DIM b5 AS _UNSIGNED _BYTE
    ' Variable: b6 stores the working value for b 6.
    DIM b6 AS _UNSIGNED _BYTE
    ' Variable: b7 stores the working value for b 7.
    DIM b7 AS _UNSIGNED _BYTE

    IF anim.nPlanes <= 0 THEN EXIT SUB
    IF anim.nPlanes > 8 THEN EXIT SUB

    ' Loop purpose: use p as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR p = 0 TO anim.nPlanes - 1
        planeBase(p) = p * anim.planeSize
    NEXT p

    ' Loop purpose: iterate through image rows or vertical positions.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR y = 0 TO anim.h - 1
        rowBase = y * anim.rowBytes
        rowPixelBase = y * anim.w
        rowPixelLimit = rowPixelBase + anim.w

        ' Loop purpose: walk through a byte-oriented range while parsing or transforming packed data.
        ' The loop order matters because later statements expect the data to be visited sequentially.
        FOR xByte = 0 TO anim.rowBytes - 1
            baseX = rowPixelBase + xByte * 8
            IF baseX >= rowPixelLimit THEN EXIT FOR

            color0 = 0: color1 = 0: color2 = 0: color3 = 0
            color4 = 0: color5 = 0: color6 = 0: color7 = 0

            SELECT CASE anim.nPlanes
                CASE 1
                    b0 = planar(planeBase(0) + rowBase + xByte)

                    IF (b0 AND 128) <> 0 THEN color0 = 1 ELSE color0 = 0
                    IF (b0 AND 64) <> 0 THEN color1 = 1 ELSE color1 = 0
                    IF (b0 AND 32) <> 0 THEN color2 = 1 ELSE color2 = 0
                    IF (b0 AND 16) <> 0 THEN color3 = 1 ELSE color3 = 0
                    IF (b0 AND 8) <> 0 THEN color4 = 1 ELSE color4 = 0
                    IF (b0 AND 4) <> 0 THEN color5 = 1 ELSE color5 = 0
                    IF (b0 AND 2) <> 0 THEN color6 = 1 ELSE color6 = 0
                    IF (b0 AND 1) <> 0 THEN color7 = 1 ELSE color7 = 0

                CASE 2
                    b0 = planar(planeBase(0) + rowBase + xByte)
                    b1 = planar(planeBase(1) + rowBase + xByte)

                    IF (b0 AND 128) <> 0 THEN color0 = 1 ELSE color0 = 0
                    IF (b1 AND 128) <> 0 THEN color0 = color0 OR 2
                    IF (b0 AND 64) <> 0 THEN color1 = 1 ELSE color1 = 0
                    IF (b1 AND 64) <> 0 THEN color1 = color1 OR 2
                    IF (b0 AND 32) <> 0 THEN color2 = 1 ELSE color2 = 0
                    IF (b1 AND 32) <> 0 THEN color2 = color2 OR 2
                    IF (b0 AND 16) <> 0 THEN color3 = 1 ELSE color3 = 0
                    IF (b1 AND 16) <> 0 THEN color3 = color3 OR 2
                    IF (b0 AND 8) <> 0 THEN color4 = 1 ELSE color4 = 0
                    IF (b1 AND 8) <> 0 THEN color4 = color4 OR 2
                    IF (b0 AND 4) <> 0 THEN color5 = 1 ELSE color5 = 0
                    IF (b1 AND 4) <> 0 THEN color5 = color5 OR 2
                    IF (b0 AND 2) <> 0 THEN color6 = 1 ELSE color6 = 0
                    IF (b1 AND 2) <> 0 THEN color6 = color6 OR 2
                    IF (b0 AND 1) <> 0 THEN color7 = 1 ELSE color7 = 0
                    IF (b1 AND 1) <> 0 THEN color7 = color7 OR 2

                CASE 3
                    b0 = planar(planeBase(0) + rowBase + xByte)
                    b1 = planar(planeBase(1) + rowBase + xByte)
                    b2 = planar(planeBase(2) + rowBase + xByte)

                    IF (b0 AND 128) <> 0 THEN color0 = 1 ELSE color0 = 0
                    IF (b1 AND 128) <> 0 THEN color0 = color0 OR 2
                    IF (b2 AND 128) <> 0 THEN color0 = color0 OR 4
                    IF (b0 AND 64) <> 0 THEN color1 = 1 ELSE color1 = 0
                    IF (b1 AND 64) <> 0 THEN color1 = color1 OR 2
                    IF (b2 AND 64) <> 0 THEN color1 = color1 OR 4
                    IF (b0 AND 32) <> 0 THEN color2 = 1 ELSE color2 = 0
                    IF (b1 AND 32) <> 0 THEN color2 = color2 OR 2
                    IF (b2 AND 32) <> 0 THEN color2 = color2 OR 4
                    IF (b0 AND 16) <> 0 THEN color3 = 1 ELSE color3 = 0
                    IF (b1 AND 16) <> 0 THEN color3 = color3 OR 2
                    IF (b2 AND 16) <> 0 THEN color3 = color3 OR 4
                    IF (b0 AND 8) <> 0 THEN color4 = 1 ELSE color4 = 0
                    IF (b1 AND 8) <> 0 THEN color4 = color4 OR 2
                    IF (b2 AND 8) <> 0 THEN color4 = color4 OR 4
                    IF (b0 AND 4) <> 0 THEN color5 = 1 ELSE color5 = 0
                    IF (b1 AND 4) <> 0 THEN color5 = color5 OR 2
                    IF (b2 AND 4) <> 0 THEN color5 = color5 OR 4
                    IF (b0 AND 2) <> 0 THEN color6 = 1 ELSE color6 = 0
                    IF (b1 AND 2) <> 0 THEN color6 = color6 OR 2
                    IF (b2 AND 2) <> 0 THEN color6 = color6 OR 4
                    IF (b0 AND 1) <> 0 THEN color7 = 1 ELSE color7 = 0
                    IF (b1 AND 1) <> 0 THEN color7 = color7 OR 2
                    IF (b2 AND 1) <> 0 THEN color7 = color7 OR 4

                CASE 4
                    b0 = planar(planeBase(0) + rowBase + xByte)
                    b1 = planar(planeBase(1) + rowBase + xByte)
                    b2 = planar(planeBase(2) + rowBase + xByte)
                    b3 = planar(planeBase(3) + rowBase + xByte)

                    IF (b0 AND 128) <> 0 THEN color0 = 1 ELSE color0 = 0
                    IF (b1 AND 128) <> 0 THEN color0 = color0 OR 2
                    IF (b2 AND 128) <> 0 THEN color0 = color0 OR 4
                    IF (b3 AND 128) <> 0 THEN color0 = color0 OR 8
                    IF (b0 AND 64) <> 0 THEN color1 = 1 ELSE color1 = 0
                    IF (b1 AND 64) <> 0 THEN color1 = color1 OR 2
                    IF (b2 AND 64) <> 0 THEN color1 = color1 OR 4
                    IF (b3 AND 64) <> 0 THEN color1 = color1 OR 8
                    IF (b0 AND 32) <> 0 THEN color2 = 1 ELSE color2 = 0
                    IF (b1 AND 32) <> 0 THEN color2 = color2 OR 2
                    IF (b2 AND 32) <> 0 THEN color2 = color2 OR 4
                    IF (b3 AND 32) <> 0 THEN color2 = color2 OR 8
                    IF (b0 AND 16) <> 0 THEN color3 = 1 ELSE color3 = 0
                    IF (b1 AND 16) <> 0 THEN color3 = color3 OR 2
                    IF (b2 AND 16) <> 0 THEN color3 = color3 OR 4
                    IF (b3 AND 16) <> 0 THEN color3 = color3 OR 8
                    IF (b0 AND 8) <> 0 THEN color4 = 1 ELSE color4 = 0
                    IF (b1 AND 8) <> 0 THEN color4 = color4 OR 2
                    IF (b2 AND 8) <> 0 THEN color4 = color4 OR 4
                    IF (b3 AND 8) <> 0 THEN color4 = color4 OR 8
                    IF (b0 AND 4) <> 0 THEN color5 = 1 ELSE color5 = 0
                    IF (b1 AND 4) <> 0 THEN color5 = color5 OR 2
                    IF (b2 AND 4) <> 0 THEN color5 = color5 OR 4
                    IF (b3 AND 4) <> 0 THEN color5 = color5 OR 8
                    IF (b0 AND 2) <> 0 THEN color6 = 1 ELSE color6 = 0
                    IF (b1 AND 2) <> 0 THEN color6 = color6 OR 2
                    IF (b2 AND 2) <> 0 THEN color6 = color6 OR 4
                    IF (b3 AND 2) <> 0 THEN color6 = color6 OR 8
                    IF (b0 AND 1) <> 0 THEN color7 = 1 ELSE color7 = 0
                    IF (b1 AND 1) <> 0 THEN color7 = color7 OR 2
                    IF (b2 AND 1) <> 0 THEN color7 = color7 OR 4
                    IF (b3 AND 1) <> 0 THEN color7 = color7 OR 8

                CASE 5
                    b0 = planar(planeBase(0) + rowBase + xByte)
                    b1 = planar(planeBase(1) + rowBase + xByte)
                    b2 = planar(planeBase(2) + rowBase + xByte)
                    b3 = planar(planeBase(3) + rowBase + xByte)
                    b4 = planar(planeBase(4) + rowBase + xByte)

                    IF (b0 AND 128) <> 0 THEN color0 = 1 ELSE color0 = 0
                    IF (b1 AND 128) <> 0 THEN color0 = color0 OR 2
                    IF (b2 AND 128) <> 0 THEN color0 = color0 OR 4
                    IF (b3 AND 128) <> 0 THEN color0 = color0 OR 8
                    IF (b4 AND 128) <> 0 THEN color0 = color0 OR 16
                    IF (b0 AND 64) <> 0 THEN color1 = 1 ELSE color1 = 0
                    IF (b1 AND 64) <> 0 THEN color1 = color1 OR 2
                    IF (b2 AND 64) <> 0 THEN color1 = color1 OR 4
                    IF (b3 AND 64) <> 0 THEN color1 = color1 OR 8
                    IF (b4 AND 64) <> 0 THEN color1 = color1 OR 16
                    IF (b0 AND 32) <> 0 THEN color2 = 1 ELSE color2 = 0
                    IF (b1 AND 32) <> 0 THEN color2 = color2 OR 2
                    IF (b2 AND 32) <> 0 THEN color2 = color2 OR 4
                    IF (b3 AND 32) <> 0 THEN color2 = color2 OR 8
                    IF (b4 AND 32) <> 0 THEN color2 = color2 OR 16
                    IF (b0 AND 16) <> 0 THEN color3 = 1 ELSE color3 = 0
                    IF (b1 AND 16) <> 0 THEN color3 = color3 OR 2
                    IF (b2 AND 16) <> 0 THEN color3 = color3 OR 4
                    IF (b3 AND 16) <> 0 THEN color3 = color3 OR 8
                    IF (b4 AND 16) <> 0 THEN color3 = color3 OR 16
                    IF (b0 AND 8) <> 0 THEN color4 = 1 ELSE color4 = 0
                    IF (b1 AND 8) <> 0 THEN color4 = color4 OR 2
                    IF (b2 AND 8) <> 0 THEN color4 = color4 OR 4
                    IF (b3 AND 8) <> 0 THEN color4 = color4 OR 8
                    IF (b4 AND 8) <> 0 THEN color4 = color4 OR 16
                    IF (b0 AND 4) <> 0 THEN color5 = 1 ELSE color5 = 0
                    IF (b1 AND 4) <> 0 THEN color5 = color5 OR 2
                    IF (b2 AND 4) <> 0 THEN color5 = color5 OR 4
                    IF (b3 AND 4) <> 0 THEN color5 = color5 OR 8
                    IF (b4 AND 4) <> 0 THEN color5 = color5 OR 16
                    IF (b0 AND 2) <> 0 THEN color6 = 1 ELSE color6 = 0
                    IF (b1 AND 2) <> 0 THEN color6 = color6 OR 2
                    IF (b2 AND 2) <> 0 THEN color6 = color6 OR 4
                    IF (b3 AND 2) <> 0 THEN color6 = color6 OR 8
                    IF (b4 AND 2) <> 0 THEN color6 = color6 OR 16
                    IF (b0 AND 1) <> 0 THEN color7 = 1 ELSE color7 = 0
                    IF (b1 AND 1) <> 0 THEN color7 = color7 OR 2
                    IF (b2 AND 1) <> 0 THEN color7 = color7 OR 4
                    IF (b3 AND 1) <> 0 THEN color7 = color7 OR 8
                    IF (b4 AND 1) <> 0 THEN color7 = color7 OR 16

                CASE 6
                    b0 = planar(planeBase(0) + rowBase + xByte)
                    b1 = planar(planeBase(1) + rowBase + xByte)
                    b2 = planar(planeBase(2) + rowBase + xByte)
                    b3 = planar(planeBase(3) + rowBase + xByte)
                    b4 = planar(planeBase(4) + rowBase + xByte)
                    b5 = planar(planeBase(5) + rowBase + xByte)

                    IF (b0 AND 128) <> 0 THEN color0 = 1 ELSE color0 = 0
                    IF (b1 AND 128) <> 0 THEN color0 = color0 OR 2
                    IF (b2 AND 128) <> 0 THEN color0 = color0 OR 4
                    IF (b3 AND 128) <> 0 THEN color0 = color0 OR 8
                    IF (b4 AND 128) <> 0 THEN color0 = color0 OR 16
                    IF (b5 AND 128) <> 0 THEN color0 = color0 OR 32
                    IF (b0 AND 64) <> 0 THEN color1 = 1 ELSE color1 = 0
                    IF (b1 AND 64) <> 0 THEN color1 = color1 OR 2
                    IF (b2 AND 64) <> 0 THEN color1 = color1 OR 4
                    IF (b3 AND 64) <> 0 THEN color1 = color1 OR 8
                    IF (b4 AND 64) <> 0 THEN color1 = color1 OR 16
                    IF (b5 AND 64) <> 0 THEN color1 = color1 OR 32
                    IF (b0 AND 32) <> 0 THEN color2 = 1 ELSE color2 = 0
                    IF (b1 AND 32) <> 0 THEN color2 = color2 OR 2
                    IF (b2 AND 32) <> 0 THEN color2 = color2 OR 4
                    IF (b3 AND 32) <> 0 THEN color2 = color2 OR 8
                    IF (b4 AND 32) <> 0 THEN color2 = color2 OR 16
                    IF (b5 AND 32) <> 0 THEN color2 = color2 OR 32
                    IF (b0 AND 16) <> 0 THEN color3 = 1 ELSE color3 = 0
                    IF (b1 AND 16) <> 0 THEN color3 = color3 OR 2
                    IF (b2 AND 16) <> 0 THEN color3 = color3 OR 4
                    IF (b3 AND 16) <> 0 THEN color3 = color3 OR 8
                    IF (b4 AND 16) <> 0 THEN color3 = color3 OR 16
                    IF (b5 AND 16) <> 0 THEN color3 = color3 OR 32
                    IF (b0 AND 8) <> 0 THEN color4 = 1 ELSE color4 = 0
                    IF (b1 AND 8) <> 0 THEN color4 = color4 OR 2
                    IF (b2 AND 8) <> 0 THEN color4 = color4 OR 4
                    IF (b3 AND 8) <> 0 THEN color4 = color4 OR 8
                    IF (b4 AND 8) <> 0 THEN color4 = color4 OR 16
                    IF (b5 AND 8) <> 0 THEN color4 = color4 OR 32
                    IF (b0 AND 4) <> 0 THEN color5 = 1 ELSE color5 = 0
                    IF (b1 AND 4) <> 0 THEN color5 = color5 OR 2
                    IF (b2 AND 4) <> 0 THEN color5 = color5 OR 4
                    IF (b3 AND 4) <> 0 THEN color5 = color5 OR 8
                    IF (b4 AND 4) <> 0 THEN color5 = color5 OR 16
                    IF (b5 AND 4) <> 0 THEN color5 = color5 OR 32
                    IF (b0 AND 2) <> 0 THEN color6 = 1 ELSE color6 = 0
                    IF (b1 AND 2) <> 0 THEN color6 = color6 OR 2
                    IF (b2 AND 2) <> 0 THEN color6 = color6 OR 4
                    IF (b3 AND 2) <> 0 THEN color6 = color6 OR 8
                    IF (b4 AND 2) <> 0 THEN color6 = color6 OR 16
                    IF (b5 AND 2) <> 0 THEN color6 = color6 OR 32
                    IF (b0 AND 1) <> 0 THEN color7 = 1 ELSE color7 = 0
                    IF (b1 AND 1) <> 0 THEN color7 = color7 OR 2
                    IF (b2 AND 1) <> 0 THEN color7 = color7 OR 4
                    IF (b3 AND 1) <> 0 THEN color7 = color7 OR 8
                    IF (b4 AND 1) <> 0 THEN color7 = color7 OR 16
                    IF (b5 AND 1) <> 0 THEN color7 = color7 OR 32

                CASE 7
                    b0 = planar(planeBase(0) + rowBase + xByte)
                    b1 = planar(planeBase(1) + rowBase + xByte)
                    b2 = planar(planeBase(2) + rowBase + xByte)
                    b3 = planar(planeBase(3) + rowBase + xByte)
                    b4 = planar(planeBase(4) + rowBase + xByte)
                    b5 = planar(planeBase(5) + rowBase + xByte)
                    b6 = planar(planeBase(6) + rowBase + xByte)

                    IF (b0 AND 128) <> 0 THEN color0 = 1 ELSE color0 = 0
                    IF (b1 AND 128) <> 0 THEN color0 = color0 OR 2
                    IF (b2 AND 128) <> 0 THEN color0 = color0 OR 4
                    IF (b3 AND 128) <> 0 THEN color0 = color0 OR 8
                    IF (b4 AND 128) <> 0 THEN color0 = color0 OR 16
                    IF (b5 AND 128) <> 0 THEN color0 = color0 OR 32
                    IF (b6 AND 128) <> 0 THEN color0 = color0 OR 64
                    IF (b0 AND 64) <> 0 THEN color1 = 1 ELSE color1 = 0
                    IF (b1 AND 64) <> 0 THEN color1 = color1 OR 2
                    IF (b2 AND 64) <> 0 THEN color1 = color1 OR 4
                    IF (b3 AND 64) <> 0 THEN color1 = color1 OR 8
                    IF (b4 AND 64) <> 0 THEN color1 = color1 OR 16
                    IF (b5 AND 64) <> 0 THEN color1 = color1 OR 32
                    IF (b6 AND 64) <> 0 THEN color1 = color1 OR 64
                    IF (b0 AND 32) <> 0 THEN color2 = 1 ELSE color2 = 0
                    IF (b1 AND 32) <> 0 THEN color2 = color2 OR 2
                    IF (b2 AND 32) <> 0 THEN color2 = color2 OR 4
                    IF (b3 AND 32) <> 0 THEN color2 = color2 OR 8
                    IF (b4 AND 32) <> 0 THEN color2 = color2 OR 16
                    IF (b5 AND 32) <> 0 THEN color2 = color2 OR 32
                    IF (b6 AND 32) <> 0 THEN color2 = color2 OR 64
                    IF (b0 AND 16) <> 0 THEN color3 = 1 ELSE color3 = 0
                    IF (b1 AND 16) <> 0 THEN color3 = color3 OR 2
                    IF (b2 AND 16) <> 0 THEN color3 = color3 OR 4
                    IF (b3 AND 16) <> 0 THEN color3 = color3 OR 8
                    IF (b4 AND 16) <> 0 THEN color3 = color3 OR 16
                    IF (b5 AND 16) <> 0 THEN color3 = color3 OR 32
                    IF (b6 AND 16) <> 0 THEN color3 = color3 OR 64
                    IF (b0 AND 8) <> 0 THEN color4 = 1 ELSE color4 = 0
                    IF (b1 AND 8) <> 0 THEN color4 = color4 OR 2
                    IF (b2 AND 8) <> 0 THEN color4 = color4 OR 4
                    IF (b3 AND 8) <> 0 THEN color4 = color4 OR 8
                    IF (b4 AND 8) <> 0 THEN color4 = color4 OR 16
                    IF (b5 AND 8) <> 0 THEN color4 = color4 OR 32
                    IF (b6 AND 8) <> 0 THEN color4 = color4 OR 64
                    IF (b0 AND 4) <> 0 THEN color5 = 1 ELSE color5 = 0
                    IF (b1 AND 4) <> 0 THEN color5 = color5 OR 2
                    IF (b2 AND 4) <> 0 THEN color5 = color5 OR 4
                    IF (b3 AND 4) <> 0 THEN color5 = color5 OR 8
                    IF (b4 AND 4) <> 0 THEN color5 = color5 OR 16
                    IF (b5 AND 4) <> 0 THEN color5 = color5 OR 32
                    IF (b6 AND 4) <> 0 THEN color5 = color5 OR 64
                    IF (b0 AND 2) <> 0 THEN color6 = 1 ELSE color6 = 0
                    IF (b1 AND 2) <> 0 THEN color6 = color6 OR 2
                    IF (b2 AND 2) <> 0 THEN color6 = color6 OR 4
                    IF (b3 AND 2) <> 0 THEN color6 = color6 OR 8
                    IF (b4 AND 2) <> 0 THEN color6 = color6 OR 16
                    IF (b5 AND 2) <> 0 THEN color6 = color6 OR 32
                    IF (b6 AND 2) <> 0 THEN color6 = color6 OR 64
                    IF (b0 AND 1) <> 0 THEN color7 = 1 ELSE color7 = 0
                    IF (b1 AND 1) <> 0 THEN color7 = color7 OR 2
                    IF (b2 AND 1) <> 0 THEN color7 = color7 OR 4
                    IF (b3 AND 1) <> 0 THEN color7 = color7 OR 8
                    IF (b4 AND 1) <> 0 THEN color7 = color7 OR 16
                    IF (b5 AND 1) <> 0 THEN color7 = color7 OR 32
                    IF (b6 AND 1) <> 0 THEN color7 = color7 OR 64

                CASE 8
                    b0 = planar(planeBase(0) + rowBase + xByte)
                    b1 = planar(planeBase(1) + rowBase + xByte)
                    b2 = planar(planeBase(2) + rowBase + xByte)
                    b3 = planar(planeBase(3) + rowBase + xByte)
                    b4 = planar(planeBase(4) + rowBase + xByte)
                    b5 = planar(planeBase(5) + rowBase + xByte)
                    b6 = planar(planeBase(6) + rowBase + xByte)
                    b7 = planar(planeBase(7) + rowBase + xByte)

                    IF (b0 AND 128) <> 0 THEN color0 = 1 ELSE color0 = 0
                    IF (b1 AND 128) <> 0 THEN color0 = color0 OR 2
                    IF (b2 AND 128) <> 0 THEN color0 = color0 OR 4
                    IF (b3 AND 128) <> 0 THEN color0 = color0 OR 8
                    IF (b4 AND 128) <> 0 THEN color0 = color0 OR 16
                    IF (b5 AND 128) <> 0 THEN color0 = color0 OR 32
                    IF (b6 AND 128) <> 0 THEN color0 = color0 OR 64
                    IF (b7 AND 128) <> 0 THEN color0 = color0 OR 128
                    IF (b0 AND 64) <> 0 THEN color1 = 1 ELSE color1 = 0
                    IF (b1 AND 64) <> 0 THEN color1 = color1 OR 2
                    IF (b2 AND 64) <> 0 THEN color1 = color1 OR 4
                    IF (b3 AND 64) <> 0 THEN color1 = color1 OR 8
                    IF (b4 AND 64) <> 0 THEN color1 = color1 OR 16
                    IF (b5 AND 64) <> 0 THEN color1 = color1 OR 32
                    IF (b6 AND 64) <> 0 THEN color1 = color1 OR 64
                    IF (b7 AND 64) <> 0 THEN color1 = color1 OR 128
                    IF (b0 AND 32) <> 0 THEN color2 = 1 ELSE color2 = 0
                    IF (b1 AND 32) <> 0 THEN color2 = color2 OR 2
                    IF (b2 AND 32) <> 0 THEN color2 = color2 OR 4
                    IF (b3 AND 32) <> 0 THEN color2 = color2 OR 8
                    IF (b4 AND 32) <> 0 THEN color2 = color2 OR 16
                    IF (b5 AND 32) <> 0 THEN color2 = color2 OR 32
                    IF (b6 AND 32) <> 0 THEN color2 = color2 OR 64
                    IF (b7 AND 32) <> 0 THEN color2 = color2 OR 128
                    IF (b0 AND 16) <> 0 THEN color3 = 1 ELSE color3 = 0
                    IF (b1 AND 16) <> 0 THEN color3 = color3 OR 2
                    IF (b2 AND 16) <> 0 THEN color3 = color3 OR 4
                    IF (b3 AND 16) <> 0 THEN color3 = color3 OR 8
                    IF (b4 AND 16) <> 0 THEN color3 = color3 OR 16
                    IF (b5 AND 16) <> 0 THEN color3 = color3 OR 32
                    IF (b6 AND 16) <> 0 THEN color3 = color3 OR 64
                    IF (b7 AND 16) <> 0 THEN color3 = color3 OR 128
                    IF (b0 AND 8) <> 0 THEN color4 = 1 ELSE color4 = 0
                    IF (b1 AND 8) <> 0 THEN color4 = color4 OR 2
                    IF (b2 AND 8) <> 0 THEN color4 = color4 OR 4
                    IF (b3 AND 8) <> 0 THEN color4 = color4 OR 8
                    IF (b4 AND 8) <> 0 THEN color4 = color4 OR 16
                    IF (b5 AND 8) <> 0 THEN color4 = color4 OR 32
                    IF (b6 AND 8) <> 0 THEN color4 = color4 OR 64
                    IF (b7 AND 8) <> 0 THEN color4 = color4 OR 128
                    IF (b0 AND 4) <> 0 THEN color5 = 1 ELSE color5 = 0
                    IF (b1 AND 4) <> 0 THEN color5 = color5 OR 2
                    IF (b2 AND 4) <> 0 THEN color5 = color5 OR 4
                    IF (b3 AND 4) <> 0 THEN color5 = color5 OR 8
                    IF (b4 AND 4) <> 0 THEN color5 = color5 OR 16
                    IF (b5 AND 4) <> 0 THEN color5 = color5 OR 32
                    IF (b6 AND 4) <> 0 THEN color5 = color5 OR 64
                    IF (b7 AND 4) <> 0 THEN color5 = color5 OR 128
                    IF (b0 AND 2) <> 0 THEN color6 = 1 ELSE color6 = 0
                    IF (b1 AND 2) <> 0 THEN color6 = color6 OR 2
                    IF (b2 AND 2) <> 0 THEN color6 = color6 OR 4
                    IF (b3 AND 2) <> 0 THEN color6 = color6 OR 8
                    IF (b4 AND 2) <> 0 THEN color6 = color6 OR 16
                    IF (b5 AND 2) <> 0 THEN color6 = color6 OR 32
                    IF (b6 AND 2) <> 0 THEN color6 = color6 OR 64
                    IF (b7 AND 2) <> 0 THEN color6 = color6 OR 128
                    IF (b0 AND 1) <> 0 THEN color7 = 1 ELSE color7 = 0
                    IF (b1 AND 1) <> 0 THEN color7 = color7 OR 2
                    IF (b2 AND 1) <> 0 THEN color7 = color7 OR 4
                    IF (b3 AND 1) <> 0 THEN color7 = color7 OR 8
                    IF (b4 AND 1) <> 0 THEN color7 = color7 OR 16
                    IF (b5 AND 1) <> 0 THEN color7 = color7 OR 32
                    IF (b6 AND 1) <> 0 THEN color7 = color7 OR 64
                    IF (b7 AND 1) <> 0 THEN color7 = color7 OR 128

                CASE ELSE
                    ' Loop purpose: use p as a counter/index while the routine processes a repeated set of values.
                    ' The loop order matters because later statements expect the data to be visited sequentially.
                    FOR p = 0 TO anim.nPlanes - 1
                        pb(p) = planar(planeBase(p) + rowBase + xByte)
                    NEXT p

                    ' Loop purpose: use p as a counter/index while the routine processes a repeated set of values.
                    ' The loop order matters because later statements expect the data to be visited sequentially.
                    FOR p = 0 TO anim.nPlanes - 1
                        bitValue = 2 ^ p
                        IF (pb(p) AND 128) <> 0 THEN color0 = color0 OR bitValue
                        IF (pb(p) AND 64) <> 0 THEN color1 = color1 OR bitValue
                        IF (pb(p) AND 32) <> 0 THEN color2 = color2 OR bitValue
                        IF (pb(p) AND 16) <> 0 THEN color3 = color3 OR bitValue
                        IF (pb(p) AND 8) <> 0 THEN color4 = color4 OR bitValue
                        IF (pb(p) AND 4) <> 0 THEN color5 = color5 OR bitValue
                        IF (pb(p) AND 2) <> 0 THEN color6 = color6 OR bitValue
                        IF (pb(p) AND 1) <> 0 THEN color7 = color7 OR bitValue
                    NEXT p
            END SELECT

            chunky(baseX) = color0
            IF baseX + 1 < rowPixelLimit THEN chunky(baseX + 1) = color1
            IF baseX + 2 < rowPixelLimit THEN chunky(baseX + 2) = color2
            IF baseX + 3 < rowPixelLimit THEN chunky(baseX + 3) = color3
            IF baseX + 4 < rowPixelLimit THEN chunky(baseX + 4) = color4
            IF baseX + 5 < rowPixelLimit THEN chunky(baseX + 5) = color5
            IF baseX + 6 < rowPixelLimit THEN chunky(baseX + 6) = color6
            IF baseX + 7 < rowPixelLimit THEN chunky(baseX + 7) = color7
        NEXT xByte
    NEXT y
END SUB

' Purpose: Read IFF/ANIM chunks and build decoder state for the Amiga animation.
' Parameters: bufOfs = working value for buf ofs; limitOfs = working value for limit ofs; ck = working value for ck; ok = success flag returned by the current routine.
SUB AmgAnimReadIffChunk (bufOfs AS _UNSIGNED _INTEGER64, limitOfs AS _UNSIGNED _INTEGER64, ck AS AmgAnimIffChunkInfo, ok AS LONG)
    ' Variable: here stores the working value for here.
    DIM here AS _UNSIGNED _INTEGER64
    ' Variable: sizeValue stores the working value for size value.
    DIM sizeValue AS _UNSIGNED LONG

    here = bufOfs

    IF here + 8 > limitOfs OR here + 8 > AmgAnimActiveSize THEN
        ok = 0
        EXIT SUB
    END IF

    ck.id = AmgAnimReadIDFromBuf$(bufOfs)
    CALL AmgAnimReadU32BE(bufOfs, sizeValue)

    ck.size = sizeValue
    ck.dataOfs = bufOfs
    ck.nextOfs = AmgAnimAlign2(ck.dataOfs + ck.size)

    IF ck.nextOfs > limitOfs OR ck.nextOfs > AmgAnimActiveSize THEN
        ok = 0
        EXIT SUB
    END IF

    ok = -1
END SUB

' Purpose: Read IFF/ANIM chunks and build decoder state for the Amiga animation.
' Parameters: bufOfs = working value for buf ofs; value = working value for value.
SUB AmgAnimReadByte (bufOfs AS _UNSIGNED _INTEGER64, value AS _UNSIGNED _BYTE)
    value = 0

    IF amg_anim_active_mode = 1 THEN
        IF amg_anim_active_pool_size > 0 THEN
            IF bufOfs <= amg_anim_active_pool_size - 1 THEN
                value = amg_anim_data_pool(amg_anim_active_pool_ofs + bufOfs)
            END IF
        END IF
    ELSE
        IF amg_anim_file_size > 0 THEN
            IF bufOfs <= amg_anim_file_size - 1 THEN
                value = amg_anim_buf(bufOfs)
            END IF
        END IF
    END IF

    bufOfs = bufOfs + 1
END SUB

' Purpose: Read IFF/ANIM chunks and build decoder state for the Amiga animation.
' Parameters: bufOfs = working value for buf ofs; value = working value for value.
SUB AmgAnimReadU16BE (bufOfs AS _UNSIGNED _INTEGER64, value AS LONG)
    ' Variable: b0 stores the working value for b 0.
    DIM b0 AS _UNSIGNED _BYTE
    ' Variable: b1 stores the working value for b 1.
    DIM b1 AS _UNSIGNED _BYTE

    CALL AmgAnimReadByte(bufOfs, b0)
    CALL AmgAnimReadByte(bufOfs, b1)

    value = b0 * 256 + b1
END SUB

' Purpose: Read IFF/ANIM chunks and build decoder state for the Amiga animation.
' Parameters: bufOfs = working value for buf ofs; value = working value for value.
SUB AmgAnimReadS16BE (bufOfs AS _UNSIGNED _INTEGER64, value AS LONG)
    ' Variable: temp stores the temporary scratch value.
    DIM temp AS LONG

    CALL AmgAnimReadU16BE(bufOfs, temp)

    IF temp >= 32768 THEN
        value = temp - 65536
    ELSE
        value = temp
    END IF
END SUB

' Purpose: Read IFF/ANIM chunks and build decoder state for the Amiga animation.
' Parameters: bufOfs = working value for buf ofs; value = working value for value.
SUB AmgAnimReadU32BE (bufOfs AS _UNSIGNED _INTEGER64, value AS _UNSIGNED LONG)
    ' Variable: b0 stores the working value for b 0.
    DIM b0 AS _UNSIGNED _BYTE
    ' Variable: b1 stores the working value for b 1.
    DIM b1 AS _UNSIGNED _BYTE
    ' Variable: b2 stores the working value for b 2.
    DIM b2 AS _UNSIGNED _BYTE
    ' Variable: b3 stores the working value for b 3.
    DIM b3 AS _UNSIGNED _BYTE

    CALL AmgAnimReadByte(bufOfs, b0)
    CALL AmgAnimReadByte(bufOfs, b1)
    CALL AmgAnimReadByte(bufOfs, b2)
    CALL AmgAnimReadByte(bufOfs, b3)

    value = b0
    value = value * 256 + b1
    value = value * 256 + b2
    value = value * 256 + b3
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation chunk data end.
' Parameters: dataOfs = buffer that holds raw, packed, or decoded byte data; size = size value for the current block, buffer, or file.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimChunkDataEnd&& (dataOfs AS _UNSIGNED _INTEGER64, size AS _UNSIGNED LONG)
    AmgAnimChunkDataEnd&& = dataOfs + size
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation align 2.
' Parameters: value = working value for value.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimAlign2&& (value AS _UNSIGNED _INTEGER64)
    IF (value AND 1) <> 0 THEN
        AmgAnimAlign2&& = value + 1
    ELSE
        AmgAnimAlign2&& = value
    END IF
END FUNCTION

' Purpose: Read IFF/ANIM chunks and build decoder state for the Amiga animation.
' Parameters: bufOfs = working value for buf ofs.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimReadIDFromBuf$ (bufOfs AS _UNSIGNED _INTEGER64)
    ' Variable: result stores the working value for result.
    DIM result AS STRING
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG
    ' Variable: b stores the color component or packed color helper used during image conversion.
    DIM b AS _UNSIGNED _BYTE

    result = SPACE$(4)
    ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 1 TO 4
        CALL AmgAnimReadByte(bufOfs, b)
        MID$(result, i, 1) = CHR$(b)
    NEXT i
    AmgAnimReadIDFromBuf$ = result
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation unpack byte run 1 row.
' Parameters: bufOfs = working value for buf ofs; bodyEnd = working value for body end; rowBuf = buffer that holds raw, packed, or decoded byte data; rowLen = row pointer, row buffer, or row index used for image processing.
SUB AmgAnimUnpackByteRun1Row (bufOfs AS _UNSIGNED _INTEGER64, bodyEnd AS _UNSIGNED _INTEGER64, rowBuf() AS _UNSIGNED _BYTE, rowLen AS LONG)
    ' Variable: ctrl stores the working value for ctrl.
    DIM ctrl AS _UNSIGNED _BYTE
    ' Variable: literalCount stores the count used to size or iterate the current data set.
    DIM literalCount AS LONG
    ' Variable: repeatCount stores the count used to size or iterate the current data set.
    DIM repeatCount AS LONG
    ' Variable: dst stores the destination-side value or buffer reference.
    DIM dst AS LONG
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG
    ' Variable: valueByte stores the working value for value byte.
    DIM valueByte AS _UNSIGNED _BYTE
    ' Variable: storeCount stores the count used to size or iterate the current data set.
    DIM storeCount AS LONG

    dst = 0

    ' Loop purpose: keep processing until the controlling condition becomes false, usually while input or timing remains active.
    DO WHILE dst < rowLen
        IF bufOfs >= bodyEnd THEN EXIT DO

        CALL AmgAnimReadByte(bufOfs, ctrl)

        IF ctrl <= 127 THEN
            literalCount = ctrl + 1
            storeCount = literalCount
            IF dst + storeCount > rowLen THEN
                storeCount = rowLen - dst
            END IF

            ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
            ' The loop order matters because later statements expect the data to be visited sequentially.
            FOR i = 1 TO literalCount
                IF bufOfs >= bodyEnd THEN EXIT FOR
                CALL AmgAnimReadByte(bufOfs, valueByte)
                IF i <= storeCount THEN
                    rowBuf(dst) = valueByte
                    dst = dst + 1
                END IF
            NEXT i

        ELSEIF ctrl = 128 THEN
            ' NOP

        ELSE
            repeatCount = 257 - ctrl
            storeCount = repeatCount
            IF dst + storeCount > rowLen THEN
                storeCount = rowLen - dst
            END IF

            IF bufOfs >= bodyEnd THEN EXIT DO
            CALL AmgAnimReadByte(bufOfs, valueByte)

            ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
            ' The loop order matters because later statements expect the data to be visited sequentially.
            FOR i = 1 TO storeCount
                rowBuf(dst) = valueByte
                dst = dst + 1
            NEXT i
        END IF
    LOOP

    ' Loop purpose: keep processing until the controlling condition becomes false, usually while input or timing remains active.
    DO WHILE dst < rowLen
        rowBuf(dst) = 0
        dst = dst + 1
    LOOP
END SUB

' Purpose: Decode or apply Amiga ANIM delta/frame data to the current bitmap.
' Parameters: anim = working value for animation; bodyOfs = working value for body ofs; bodySize = working value for body size; compression = working value for compression; planar = working value for planar.
SUB AmgAnimDecodeILBMBodyToPlanar (anim AS AmgAnimInfo, bodyOfs AS _UNSIGNED _INTEGER64, bodySize AS _UNSIGNED LONG, compression AS LONG, planar() AS _UNSIGNED _BYTE)
    ' Variable: totalPlanar stores the working value for total planar.
    DIM totalPlanar AS LONG
    ' Variable: planeBase stores the working value for plane base.
    DIM planeBase AS LONG
    ' Variable: destOfs stores the working value for dest ofs.
    DIM destOfs AS LONG
    ' Variable: y stores the vertical pixel or coordinate index.
    DIM y AS LONG
    ' Variable: p stores the generic pointer or position value.
    DIM p AS LONG
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG
    ' Variable: b stores the color component or packed color helper used during image conversion.
    DIM b AS _UNSIGNED _BYTE
    ' Variable: bodyEnd stores the working value for body end.
    DIM bodyEnd AS _UNSIGNED _INTEGER64
    ' Variable: bufOfs stores the working value for buf ofs.
    DIM bufOfs AS _UNSIGNED _INTEGER64
    ' Variable: planarMem stores the memory handle or memory-related helper value.
    DIM planarMem AS _MEM
    ' dynamic array: rowBuf is resized here to hold the buffer that holds raw, packed, or decoded byte data.
    REDIM rowBuf(0 TO 0) AS _UNSIGNED _BYTE

    totalPlanar = anim.rowBytes * anim.h * anim.nPlanes
    bodyEnd = bodyOfs + bodySize
    bufOfs = bodyOfs

    IF anim.rowBytes <= 0 THEN EXIT SUB
    ' dynamic array: rowBuf is resized here to hold the buffer that holds raw, packed, or decoded byte data.
    REDIM rowBuf(0 TO anim.rowBytes - 1) AS _UNSIGNED _BYTE

    IF compression = 0 THEN
        ' Loop purpose: iterate through image rows or vertical positions.
        ' The loop order matters because later statements expect the data to be visited sequentially.
        FOR y = 0 TO anim.h - 1
            ' Loop purpose: use p as a counter/index while the routine processes a repeated set of values.
            ' The loop order matters because later statements expect the data to be visited sequentially.
            FOR p = 0 TO anim.nPlanes - 1
                planeBase = p * anim.planeSize
                destOfs = planeBase + y * anim.rowBytes

                ' Loop purpose: walk through a byte-oriented range while parsing or transforming packed data.
                ' The loop order matters because later statements expect the data to be visited sequentially.
                FOR i = 0 TO anim.rowBytes - 1
                    IF bufOfs >= bodyEnd THEN
                        '                         Print "BODY ends too early."
                        EXIT SUB
                    END IF

                    CALL AmgAnimReadByte(bufOfs, b)
                    planar(destOfs + i) = b
                NEXT i
            NEXT p
        NEXT y

    ELSEIF compression = 1 THEN
        planarMem = _MEM(planar())

        ' Loop purpose: iterate through image rows or vertical positions.
        ' The loop order matters because later statements expect the data to be visited sequentially.
        FOR y = 0 TO anim.h - 1
            ' Loop purpose: use p as a counter/index while the routine processes a repeated set of values.
            ' The loop order matters because later statements expect the data to be visited sequentially.
            FOR p = 0 TO anim.nPlanes - 1
                planeBase = p * anim.planeSize
                destOfs = planeBase + y * anim.rowBytes

                CALL AmgAnimUnpackByteRun1Row(bufOfs, bodyEnd, rowBuf(), anim.rowBytes)
                _MEMPUT planarMem, planarMem.OFFSET + destOfs, rowBuf()
            NEXT p
        NEXT y

        IF _MEMEXISTS(planarMem) THEN _MEMFREE planarMem
    ELSE
        '         Print "Unsupported BODY compression:"; compression
    END IF
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation validate first frame bmhd.
' Parameters: ilbm = working value for ILBM; ok = success flag returned by the current routine.
SUB AmgAnimValidateFirstFrameBMHD (ilbm AS AmgAnimIlbmInfo, ok AS LONG)
    ok = -1

    IF ilbm.w <= 0 OR ilbm.h <= 0 THEN
        '         Print "Invalid BMHD size."
        ok = 0
        EXIT SUB
    END IF

    IF ilbm.nPlanes < 1 OR ilbm.nPlanes > 8 THEN
        '         Print "Only 1..8 bitplanes are supported."
        ok = 0
        EXIT SUB
    END IF

    IF ilbm.masking <> 0 THEN
        '         Print "Mask plane is not supported in this build."
        ok = 0
        EXIT SUB
    END IF

    IF ilbm.compression <> 0 AND ilbm.compression <> 1 THEN
        '         Print "Only BODY compression 0 and 1 are supported."
        ok = 0
        EXIT SUB
    END IF
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation validate frame anhd.
' Parameters: anhd = working value for anhd; ok = success flag returned by the current routine.
SUB AmgAnimValidateFrameANHD (anhd AS AmgAnimAnhdInfo, ok AS LONG)
    ok = -1

    IF anhd.valid = 0 THEN
        '         Print "ANHD missing or invalid."
        ok = 0
        EXIT SUB
    END IF

    IF anhd.operation <> 0 AND anhd.operation <> 5 AND anhd.operation <> 7 THEN
        '         Print "Only ANHD operation 0, 5 and 7 are supported."
        ok = 0
        EXIT SUB
    END IF

    ' Real-world op5/op7 files may carry non-zero bits or interleave metadata.
    ' Do not reject them during indexing.
END SUB

' Purpose: Decode or apply Amiga ANIM delta/frame data to the current bitmap.
' Parameters: anim = working value for animation; dltaOfs = working value for dlta ofs; dltaSize = working value for dlta size; planar = working value for planar.
SUB AmgAnimApplyDLTAOp5 (anim AS AmgAnimInfo, dltaOfs AS _UNSIGNED _INTEGER64, dltaSize AS _UNSIGNED LONG, planar() AS _UNSIGNED _BYTE)
    ' Array: ptrTable stores the working value for ptr table.
    DIM ptrTable(0 TO 15) AS _UNSIGNED LONG
    ' Variable: p stores the generic pointer or position value.
    DIM p AS LONG
    ' Variable: col stores the column index or color-related value.
    DIM col AS LONG
    ' Variable: opCount stores the count used to size or iterate the current data set.
    DIM opCount AS LONG
    ' Variable: opCode stores the working value for op code.
    DIM opCode AS LONG
    ' Variable: runCount stores the count used to size or iterate the current data set.
    DIM runCount AS LONG
    ' Variable: srcOfs stores the working value for src ofs.
    DIM srcOfs AS _UNSIGNED _INTEGER64
    ' Variable: planeBase stores the working value for plane base.
    DIM planeBase AS LONG
    ' Variable: planeEnd stores the working value for plane end.
    DIM planeEnd AS LONG
    ' Variable: colEnd stores the column index or color-related value.
    DIM colEnd AS LONG
    ' Variable: dstOfs stores the working value for dst ofs.
    DIM dstOfs AS LONG
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG
    ' Variable: b stores the color component or packed color helper used during image conversion.
    DIM b AS _UNSIGNED _BYTE
    ' Variable: valueByte stores the working value for value byte.
    DIM valueByte AS _UNSIGNED _BYTE
    ' Variable: bufOfs stores the working value for buf ofs.
    DIM bufOfs AS _UNSIGNED _INTEGER64
    ' Variable: dltaEnd stores the working value for dlta end.
    DIM dltaEnd AS _UNSIGNED _INTEGER64

    dltaEnd = dltaOfs + dltaSize
    bufOfs = dltaOfs

    ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 0 TO 15
        ptrTable(i) = 0
    NEXT i

    ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 0 TO 15
        CALL AmgAnimReadU32BE(bufOfs, ptrTable(i))
    NEXT i

    ' Loop purpose: use p as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR p = 0 TO anim.nPlanes - 1
        IF ptrTable(p) <> 0 THEN
            srcOfs = dltaOfs + ptrTable(p)
            IF srcOfs >= dltaEnd THEN
                '                 Print "DLTA op5 pointer outside chunk."
                EXIT SUB
            END IF

            planeBase = p * anim.planeSize
            planeEnd = planeBase + anim.planeSize
            bufOfs = srcOfs

            ' Loop purpose: iterate through image columns, pixels, or horizontal positions.
            ' The loop order matters because later statements expect the data to be visited sequentially.
            FOR col = 0 TO anim.rowBytes - 1
                CALL AmgAnimReadByte(bufOfs, b)
                opCount = b
                dstOfs = planeBase + col
                colEnd = planeEnd + col

                ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
                ' The loop order matters because later statements expect the data to be visited sequentially.
                FOR i = 1 TO opCount
                    CALL AmgAnimReadByte(bufOfs, b)
                    opCode = b

                    IF opCode = 0 THEN
                        CALL AmgAnimReadByte(bufOfs, b)
                        runCount = b
                        CALL AmgAnimReadByte(bufOfs, valueByte)

                        ' Loop purpose: keep processing until the controlling condition becomes false, usually while input or timing remains active.
                        DO WHILE runCount > 0
                            IF dstOfs < planeBase OR dstOfs >= planeEnd THEN
                                '                                 Print "DLTA op5 SAME overruns plane."
                                EXIT SUB
                            END IF

                            planar(dstOfs) = valueByte
                            dstOfs = dstOfs + anim.rowBytes
                            runCount = runCount - 1
                        LOOP

                    ELSEIF (opCode AND &H80) <> 0 THEN
                        runCount = opCode AND &H7F

                        ' Loop purpose: keep processing until the controlling condition becomes false, usually while input or timing remains active.
                        DO WHILE runCount > 0
                            IF dstOfs < planeBase OR dstOfs >= planeEnd THEN
                                '                                 Print "DLTA op5 UNIQ overruns plane."
                                EXIT SUB
                            END IF

                            CALL AmgAnimReadByte(bufOfs, valueByte)
                            planar(dstOfs) = valueByte
                            dstOfs = dstOfs + anim.rowBytes
                            runCount = runCount - 1
                        LOOP

                    ELSE
                        dstOfs = dstOfs + opCode * anim.rowBytes

                        IF dstOfs > colEnd THEN
                            '                             Print "DLTA op5 SKIP overruns plane column."
                            EXIT SUB
                        END IF
                    END IF
                NEXT i
            NEXT col
        END IF
    NEXT p
END SUB

' Purpose: Decode or apply Amiga ANIM delta/frame data to the current bitmap.
' Parameters: anim = working value for animation; dltaOfs = working value for dlta ofs; dltaSize = working value for dlta size; anhdBits = working value for anhd bits; planar = working value for planar.
SUB AmgAnimApplyDLTAOp7 (anim AS AmgAnimInfo, dltaOfs AS _UNSIGNED _INTEGER64, dltaSize AS _UNSIGNED LONG, anhdBits AS _UNSIGNED LONG, planar() AS _UNSIGNED _BYTE)
    ' Array: opPtrTable stores the working value for op ptr table.
    DIM opPtrTable(0 TO 7) AS _UNSIGNED LONG
    ' Array: dataPtrTable stores the buffer that holds raw, packed, or decoded byte data.
    DIM dataPtrTable(0 TO 7) AS _UNSIGNED LONG
    ' Variable: p stores the generic pointer or position value.
    DIM p AS LONG
    ' Variable: col stores the column index or color-related value.
    DIM col AS LONG
    ' Variable: colCount stores the column index or color-related value.
    DIM colCount AS LONG
    ' Variable: itemSize stores the working value for item size.
    DIM itemSize AS LONG
    ' Variable: opCount stores the count used to size or iterate the current data set.
    DIM opCount AS LONG
    ' Variable: opCode stores the working value for op code.
    DIM opCode AS LONG
    ' Variable: runCount stores the count used to size or iterate the current data set.
    DIM runCount AS LONG
    ' Variable: opListOfs stores the working value for op list ofs.
    DIM opListOfs AS _UNSIGNED _INTEGER64
    ' Variable: dataListOfs stores the buffer that holds raw, packed, or decoded byte data.
    DIM dataListOfs AS _UNSIGNED _INTEGER64
    ' Variable: planeBase stores the working value for plane base.
    DIM planeBase AS LONG
    ' Variable: planeEnd stores the working value for plane end.
    DIM planeEnd AS LONG
    ' Variable: dstOfs stores the working value for dst ofs.
    DIM dstOfs AS LONG
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG
    ' Variable: j stores the secondary loop index.
    DIM j AS LONG
    ' Variable: b stores the color component or packed color helper used during image conversion.
    DIM b AS _UNSIGNED _BYTE
    ' Array: valueBytes stores the working value for value bytes.
    DIM valueBytes(0 TO 3) AS _UNSIGNED _BYTE
    ' Variable: bufOfs stores the working value for buf ofs.
    DIM bufOfs AS _UNSIGNED _INTEGER64
    ' Variable: dltaEnd stores the working value for dlta end.
    DIM dltaEnd AS _UNSIGNED _INTEGER64

    dltaEnd = dltaOfs + dltaSize
    bufOfs = dltaOfs

    ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 0 TO 7
        opPtrTable(i) = 0
    NEXT i

    ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 0 TO 7
        dataPtrTable(i) = 0
    NEXT i

    ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 0 TO 7
        CALL AmgAnimReadU32BE(bufOfs, opPtrTable(i))
    NEXT i

    ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 0 TO 7
        CALL AmgAnimReadU32BE(bufOfs, dataPtrTable(i))
    NEXT i

    IF (anhdBits AND 1) <> 0 THEN
        itemSize = 4
    ELSE
        itemSize = 2
    END IF

    IF itemSize <= 0 THEN EXIT SUB
    IF (anim.rowBytes MOD itemSize) <> 0 THEN
        '         Print "DLTA op7 item size does not divide row bytes."
        EXIT SUB
    END IF

    colCount = anim.rowBytes \ itemSize

    ' Loop purpose: use p as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR p = 0 TO anim.nPlanes - 1
        IF opPtrTable(p) <> 0 THEN
            IF dataPtrTable(p) = 0 THEN
                '                 Print "DLTA op7 data pointer missing."
                EXIT SUB
            END IF

            opListOfs = dltaOfs + opPtrTable(p)
            dataListOfs = dltaOfs + dataPtrTable(p)

            IF opListOfs >= dltaEnd THEN
                '                 Print "DLTA op7 opcode pointer outside chunk."
                EXIT SUB
            END IF

            IF dataListOfs >= dltaEnd THEN
                '                 Print "DLTA op7 data pointer outside chunk."
                EXIT SUB
            END IF

            planeBase = p * anim.planeSize
            planeEnd = planeBase + anim.planeSize
            bufOfs = opListOfs

            ' Loop purpose: iterate through image columns, pixels, or horizontal positions.
            ' The loop order matters because later statements expect the data to be visited sequentially.
            FOR col = 0 TO colCount - 1
                IF bufOfs >= dltaEnd THEN
                    '                     Print "DLTA op7 opcode list ends too early."
                    EXIT SUB
                END IF

                CALL AmgAnimReadByte(bufOfs, b)
                opCount = b
                dstOfs = planeBase + col * itemSize

                ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
                ' The loop order matters because later statements expect the data to be visited sequentially.
                FOR i = 1 TO opCount
                    IF bufOfs >= dltaEnd THEN
                        '                         Print "DLTA op7 opcode stream ends too early."
                        EXIT SUB
                    END IF

                    CALL AmgAnimReadByte(bufOfs, b)
                    opCode = b

                    IF opCode = 0 THEN
                        IF bufOfs >= dltaEnd THEN
                            '                             Print "DLTA op7 SAME count missing."
                            EXIT SUB
                        END IF

                        CALL AmgAnimReadByte(bufOfs, b)
                        runCount = b

                        IF dataListOfs + itemSize > dltaEnd THEN
                            '                             Print "DLTA op7 SAME data overruns chunk."
                            EXIT SUB
                        END IF

                        ' Loop purpose: walk through a byte-oriented range while parsing or transforming packed data.
                        ' The loop order matters because later statements expect the data to be visited sequentially.
                        FOR j = 0 TO itemSize - 1
                            valueBytes(j) = AmgAnimGetActiveByte(dataListOfs + j)
                        NEXT j
                        dataListOfs = dataListOfs + itemSize

                        ' Loop purpose: keep processing until the controlling condition becomes false, usually while input or timing remains active.
                        DO WHILE runCount > 0
                            IF dstOfs < planeBase OR dstOfs + itemSize > planeEnd THEN
                                '                                 Print "DLTA op7 SAME overruns plane."
                                EXIT SUB
                            END IF

                            ' Loop purpose: walk through a byte-oriented range while parsing or transforming packed data.
                            ' The loop order matters because later statements expect the data to be visited sequentially.
                            FOR j = 0 TO itemSize - 1
                                planar(dstOfs + j) = valueBytes(j)
                            NEXT j

                            dstOfs = dstOfs + anim.rowBytes
                            runCount = runCount - 1
                        LOOP

                    ELSEIF (opCode AND &H80) <> 0 THEN
                        runCount = opCode AND &H7F

                        ' Loop purpose: keep processing until the controlling condition becomes false, usually while input or timing remains active.
                        DO WHILE runCount > 0
                            IF dataListOfs + itemSize > dltaEnd THEN
                                '                                 Print "DLTA op7 UNIQ data overruns chunk."
                                EXIT SUB
                            END IF

                            IF dstOfs < planeBase OR dstOfs + itemSize > planeEnd THEN
                                '                                 Print "DLTA op7 UNIQ overruns plane."
                                EXIT SUB
                            END IF

                            ' Loop purpose: walk through a byte-oriented range while parsing or transforming packed data.
                            ' The loop order matters because later statements expect the data to be visited sequentially.
                            FOR j = 0 TO itemSize - 1
                                planar(dstOfs + j) = AmgAnimGetActiveByte(dataListOfs + j)
                            NEXT j

                            dataListOfs = dataListOfs + itemSize
                            dstOfs = dstOfs + anim.rowBytes
                            runCount = runCount - 1
                        LOOP

                    ELSE
                        dstOfs = dstOfs + opCode * anim.rowBytes

                        IF dstOfs < planeBase OR dstOfs > planeEnd THEN
                            '                             Print "DLTA op7 SKIP overruns plane column."
                            EXIT SUB
                        END IF
                    END IF
                NEXT i
            NEXT col
        END IF
    NEXT p
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation copy planar buffer.
' Parameters: src = source-side value or buffer reference; dst = destination-side value or buffer reference.
SUB AmgAnimCopyPlanarBuffer (src() AS _UNSIGNED _BYTE, dst() AS _UNSIGNED _BYTE)
    ' Variable: dstMem stores the memory handle or memory-related helper value.
    DIM dstMem AS _MEM

    IF UBOUND(src) <> UBOUND(dst) THEN EXIT SUB
    dstMem = _MEM(dst())
    _MEMPUT dstMem, dstMem.OFFSET, src()
    IF _MEMEXISTS(dstMem) THEN _MEMFREE dstMem
END SUB

' Purpose: Convert decoded Amiga bitmap state into a QB64 image.
' Parameters: targetImg = QB64 image handle used to store or draw decoded pixels; anim = working value for animation; pal = working value for pal; chunky = working value for chunky.
SUB AmgAnimRenderChunkyFrameMem (animId AS LONG, anim AS AmgAnimInfo, pal() AS AmgAnimRGB8, chunky() AS _UNSIGNED _BYTE)
    ' Variable: x stores the horizontal pixel or coordinate index.
    DIM x AS LONG
    ' Variable: y stores the vertical pixel or coordinate index.
    DIM y AS LONG
    ' Variable: idx stores the working value for idx.
    DIM idx AS LONG
    ' Variable: rr stores the working value for rr.
    DIM rr AS LONG
    ' Variable: gg stores the working value for gg.
    DIM gg AS LONG
    ' Variable: bb stores the working value for bb.
    DIM bb AS LONG
    ' Variable: ctrl stores the working value for ctrl.
    DIM ctrl AS LONG
    ' Variable: dataValue stores the buffer that holds raw, packed, or decoded byte data.
    DIM dataValue AS LONG
    ' Variable: hamDataBits stores the buffer that holds raw, packed, or decoded byte data.
    DIM hamDataBits AS LONG
    ' Variable: hamDataMask stores the buffer that holds raw, packed, or decoded byte data.
    DIM hamDataMask AS LONG
    ' Variable: rowOfs stores the row pointer, row buffer, or row index used for image processing.
    DIM rowOfs AS LONG
    ' Variable: pixelIndex stores the index variable used to address the current item.
    DIM pixelIndex AS LONG
    ' Variable: frameMem stores the memory handle or memory-related helper value.
    DIM frameMem AS _MEM
    ' Variable: pixelCount stores the count used to size or iterate the current data set.
    DIM pixelCount AS LONG
    ' Array: pal32 stores the working value for pal 32.
    DIM pal32(0 TO 255) AS _UNSIGNED LONG
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG

    IF AmgAnimValidId(animId) = 0 THEN EXIT SUB
    IF AmgAnimItems(animId).CanvasImage > -2 THEN EXIT SUB
    IF _MEMEXISTS(AmgAnimCanvasMem(animId)) = 0 THEN EXIT SUB
    pixelCount = anim.w * anim.h
    IF pixelCount <= 0 THEN EXIT SUB
    IF pixelCount <> amg_anim_scratch_pixels_size THEN
        ' dynamic array: amg_anim_scratch_pixels is resized here to hold the working value for Amiga animation scratch pixels.
        REDIM amg_anim_scratch_pixels(0 TO pixelCount - 1) AS _UNSIGNED LONG
        amg_anim_scratch_pixels_size = pixelCount
    END IF

    IF anim.isHAM THEN
        hamDataBits = anim.nPlanes - 2
        IF hamDataBits < 1 THEN hamDataBits = 1
        hamDataMask = 2 ^ hamDataBits - 1

        ' Loop purpose: iterate through image rows or vertical positions.
        ' The loop order matters because later statements expect the data to be visited sequentially.
        FOR y = 0 TO anim.h - 1
            rowOfs = y * anim.w
            rr = 0
            gg = 0
            bb = 0

            ' Loop purpose: iterate through image columns, pixels, or horizontal positions.
            ' The loop order matters because later statements expect the data to be visited sequentially.
            FOR x = 0 TO anim.w - 1
                idx = chunky(rowOfs + x)
                ctrl = idx \ (2 ^ hamDataBits)
                dataValue = idx AND hamDataMask

                SELECT CASE ctrl
                    CASE 0
                        IF dataValue >= 0 AND dataValue <= UBOUND(pal) THEN
                            rr = pal(dataValue).r
                            gg = pal(dataValue).g
                            bb = pal(dataValue).b
                        ELSE
                            rr = 255
                            gg = 0
                            bb = 255
                        END IF
                    CASE 1
                        IF hamDataBits = 6 THEN
                            bb = (dataValue * 4) OR (bb AND 3)
                        ELSEIF hamDataBits = 4 THEN
                            bb = dataValue * 17
                        ELSE
                            bb = (dataValue * 255) \ hamDataMask
                        END IF
                    CASE 2
                        IF hamDataBits = 6 THEN
                            rr = (dataValue * 4) OR (rr AND 3)
                        ELSEIF hamDataBits = 4 THEN
                            rr = dataValue * 17
                        ELSE
                            rr = (dataValue * 255) \ hamDataMask
                        END IF
                    CASE 3
                        IF hamDataBits = 6 THEN
                            gg = (dataValue * 4) OR (gg AND 3)
                        ELSEIF hamDataBits = 4 THEN
                            gg = dataValue * 17
                        ELSE
                            gg = (dataValue * 255) \ hamDataMask
                        END IF
                END SELECT

                pixelIndex = rowOfs + x
                amg_anim_scratch_pixels(pixelIndex) = _RGB32(rr, gg, bb)
            NEXT x
        NEXT y
    ELSE
        ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
        ' The loop order matters because later statements expect the data to be visited sequentially.
        FOR i = 0 TO 255
            IF i <= UBOUND(pal) THEN
                pal32(i) = _RGB32(pal(i).r, pal(i).g, pal(i).b)
            ELSE
                pal32(i) = _RGB32(255, 0, 255)
            END IF
        NEXT i

        ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
        ' The loop order matters because later statements expect the data to be visited sequentially.
        FOR i = 0 TO pixelCount - 1
            amg_anim_scratch_pixels(i) = pal32(chunky(i))
        NEXT i
    END IF

    frameMem = AmgAnimCanvasMem(animId)
    IF _MEMEXISTS(frameMem) = 0 THEN EXIT SUB
    _MEMPUT frameMem, frameMem.OFFSET, amg_anim_scratch_pixels()
END SUB

' Purpose: Initialize lookup tables used by the fast planar renderer.
' Parameters: none.
SUB AmgAnimInitPlanarRenderLUT ()
    ' Variable: planeIndex stores the index variable used to address the current item.
    DIM planeIndex AS LONG
    ' Variable: byteValue stores the current byte value being expanded into lookup entries.
    DIM byteValue AS LONG
    ' Variable: tableIndex stores the linearized index into the packed lookup tables.
    DIM tableIndex AS LONG
    ' Variable: weightValue stores the bit weight contributed by the current plane.
    DIM weightValue AS _UNSIGNED LONG
    ' Variable: packLo stores packed contributions for the first four pixels of an 8-pixel group.
    DIM packLo AS _UNSIGNED LONG
    ' Variable: packHi stores packed contributions for the last four pixels of an 8-pixel group.
    DIM packHi AS _UNSIGNED LONG
    ' Variable: mul1 stores the byte multiplier for packed pixel 1.
    DIM mul1 AS _UNSIGNED LONG
    ' Variable: mul2 stores the byte multiplier for packed pixel 2.
    DIM mul2 AS _UNSIGNED LONG
    ' Variable: mul3 stores the byte multiplier for packed pixel 3.
    DIM mul3 AS _UNSIGNED LONG

    IF amg_anim_plane_pack_ready THEN EXIT SUB

    mul1 = 256
    mul2 = 65536
    mul3 = 16777216

    REDIM amg_anim_plane_pack_lo(0 TO 2047) AS _UNSIGNED LONG
    REDIM amg_anim_plane_pack_hi(0 TO 2047) AS _UNSIGNED LONG

    ' Loop purpose: build one lookup slice per bitplane.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR planeIndex = 0 TO 7
        weightValue = 2 ^ planeIndex

        ' Loop purpose: expand each possible source byte into packed pixel contributions.
        ' The loop order matters because later statements expect the data to be visited sequentially.
        FOR byteValue = 0 TO 255
            tableIndex = planeIndex * 256 + byteValue
            packLo = 0
            packHi = 0

            IF (byteValue AND 128) <> 0 THEN packLo = packLo OR weightValue
            IF (byteValue AND 64) <> 0 THEN packLo = packLo OR (weightValue * mul1)
            IF (byteValue AND 32) <> 0 THEN packLo = packLo OR (weightValue * mul2)
            IF (byteValue AND 16) <> 0 THEN packLo = packLo OR (weightValue * mul3)

            IF (byteValue AND 8) <> 0 THEN packHi = packHi OR weightValue
            IF (byteValue AND 4) <> 0 THEN packHi = packHi OR (weightValue * mul1)
            IF (byteValue AND 2) <> 0 THEN packHi = packHi OR (weightValue * mul2)
            IF (byteValue AND 1) <> 0 THEN packHi = packHi OR (weightValue * mul3)

            amg_anim_plane_pack_lo(tableIndex) = packLo
            amg_anim_plane_pack_hi(tableIndex) = packHi
        NEXT byteValue
    NEXT planeIndex

    amg_anim_plane_pack_ready = -1
END SUB

' Purpose: Convert decoded Amiga bitmap state into a QB64 image.
' Parameters: targetImg = QB64 image handle used to store or draw decoded pixels; anim = working value for animation; pal = working value for pal; planar = working value for planar.
SUB AmgAnimRenderPlanarFrameMem (animId AS LONG, anim AS AmgAnimInfo, pal() AS AmgAnimRGB8, planar() AS _UNSIGNED _BYTE)
    ' Variable: y stores the vertical pixel or coordinate index.
    DIM y AS LONG
    ' Variable: xByte stores the working value for x byte.
    DIM xByte AS LONG
    ' Variable: p stores the generic pointer or position value.
    DIM p AS LONG
    ' Variable: rowBase stores the row pointer, row buffer, or row index used for image processing.
    DIM rowBase AS LONG
    ' Array: planeBase stores the working value for plane base.
    DIM planeBase(0 TO 7) AS LONG
    ' Variable: baseX stores the working value for base x.
    DIM baseX AS LONG
    ' Variable: pixelCount stores the count used to size or iterate the current data set.
    DIM pixelCount AS LONG
    ' Variable: frameMem stores the memory handle or memory-related helper value.
    DIM frameMem AS _MEM
    ' Array: pal32 stores the working value for pal 32.
    DIM pal32(0 TO 255) AS _UNSIGNED LONG
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG
    ' Variable: fullByteCount stores how many complete 8-pixel source bytes are needed for the row width.
    DIM fullByteCount AS LONG
    ' Variable: tailPixels stores how many pixels are left in the partial byte at row end.
    DIM tailPixels AS LONG
    ' Variable: byteOfs stores the source offset of the current planar byte inside the row.
    DIM byteOfs AS LONG
    ' Variable: tableIndex stores the linearized index into the packed planar render lookup tables.
    DIM tableIndex AS LONG
    ' Variable: packLo stores packed 4-pixel indices for pixels 0..3 of the current byte group.
    DIM packLo AS _UNSIGNED LONG
    ' Variable: packHi stores packed 4-pixel indices for pixels 4..7 of the current byte group.
    DIM packHi AS _UNSIGNED LONG

    IF AmgAnimValidId(animId) = 0 THEN EXIT SUB
    IF AmgAnimItems(animId).CanvasImage > -2 THEN EXIT SUB
    IF _MEMEXISTS(AmgAnimCanvasMem(animId)) = 0 THEN EXIT SUB
    IF anim.isHAM THEN
        CALL AmgAnimPlanarToChunky(anim, planar(), amg_anim_scratch_chunky())
        CALL AmgAnimRenderChunkyFrameMem(animId, anim, pal(), amg_anim_scratch_chunky())
        EXIT SUB
    END IF

    pixelCount = anim.w * anim.h
    IF pixelCount <= 0 THEN EXIT SUB
    IF pixelCount <> amg_anim_scratch_pixels_size THEN
        ' dynamic array: amg_anim_scratch_pixels is resized here to hold the working value for Amiga animation scratch pixels.
        REDIM amg_anim_scratch_pixels(0 TO pixelCount - 1) AS _UNSIGNED LONG
        amg_anim_scratch_pixels_size = pixelCount
    END IF

    IF anim.nPlanes <= 0 THEN EXIT SUB
    IF anim.nPlanes > 8 THEN
        CALL AmgAnimPlanarToChunky(anim, planar(), amg_anim_scratch_chunky())
        CALL AmgAnimRenderChunkyFrameMem(animId, anim, pal(), amg_anim_scratch_chunky())
        EXIT SUB
    END IF

    CALL AmgAnimInitPlanarRenderLUT

    ' Loop purpose: convert palette entries once per render pass.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 0 TO 255
        IF i <= UBOUND(pal) THEN
            pal32(i) = _RGB32(pal(i).r, pal(i).g, pal(i).b)
        ELSE
            pal32(i) = _RGB32(255, 0, 255)
        END IF
    NEXT i

    ' Loop purpose: precompute the start offset of each bitplane in the planar source buffer.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR p = 0 TO anim.nPlanes - 1
        planeBase(p) = p * anim.planeSize
    NEXT p

    fullByteCount = anim.w \ 8
    tailPixels = anim.w AND 7

    ' Loop purpose: iterate through image rows or vertical positions.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR y = 0 TO anim.h - 1
        rowBase = y * anim.rowBytes
        baseX = y * anim.w

        ' Loop purpose: decode all full 8-pixel byte groups without width-bound checks.
        ' The loop order matters because later statements expect the data to be visited sequentially.
        FOR xByte = 0 TO fullByteCount - 1
            byteOfs = rowBase + xByte
            packLo = 0
            packHi = 0

            ' Loop purpose: merge the contribution from each active plane into the packed pixel indices.
            ' The loop order matters because later statements expect the data to be visited sequentially.
            FOR p = 0 TO anim.nPlanes - 1
                tableIndex = p * 256 + planar(planeBase(p) + byteOfs)
                packLo = packLo OR amg_anim_plane_pack_lo(tableIndex)
                packHi = packHi OR amg_anim_plane_pack_hi(tableIndex)
            NEXT p

            amg_anim_scratch_pixels(baseX) = pal32(packLo AND 255)
            amg_anim_scratch_pixels(baseX + 1) = pal32((packLo \ 256) AND 255)
            amg_anim_scratch_pixels(baseX + 2) = pal32((packLo \ 65536) AND 255)
            amg_anim_scratch_pixels(baseX + 3) = pal32((packLo \ 16777216) AND 255)
            amg_anim_scratch_pixels(baseX + 4) = pal32(packHi AND 255)
            amg_anim_scratch_pixels(baseX + 5) = pal32((packHi \ 256) AND 255)
            amg_anim_scratch_pixels(baseX + 6) = pal32((packHi \ 65536) AND 255)
            amg_anim_scratch_pixels(baseX + 7) = pal32((packHi \ 16777216) AND 255)

            baseX = baseX + 8
        NEXT xByte

        IF tailPixels > 0 THEN
            byteOfs = rowBase + fullByteCount
            packLo = 0
            packHi = 0

            ' Loop purpose: merge the contribution from each active plane into the partial byte at row end.
            ' The loop order matters because later statements expect the data to be visited sequentially.
            FOR p = 0 TO anim.nPlanes - 1
                tableIndex = p * 256 + planar(planeBase(p) + byteOfs)
                packLo = packLo OR amg_anim_plane_pack_lo(tableIndex)
                packHi = packHi OR amg_anim_plane_pack_hi(tableIndex)
            NEXT p

            SELECT CASE tailPixels
                CASE 7
                    amg_anim_scratch_pixels(baseX + 6) = pal32((packHi \ 65536) AND 255)
                    amg_anim_scratch_pixels(baseX + 5) = pal32((packHi \ 256) AND 255)
                    amg_anim_scratch_pixels(baseX + 4) = pal32(packHi AND 255)
                    amg_anim_scratch_pixels(baseX + 3) = pal32((packLo \ 16777216) AND 255)
                    amg_anim_scratch_pixels(baseX + 2) = pal32((packLo \ 65536) AND 255)
                    amg_anim_scratch_pixels(baseX + 1) = pal32((packLo \ 256) AND 255)
                    amg_anim_scratch_pixels(baseX) = pal32(packLo AND 255)
                CASE 6
                    amg_anim_scratch_pixels(baseX + 5) = pal32((packHi \ 256) AND 255)
                    amg_anim_scratch_pixels(baseX + 4) = pal32(packHi AND 255)
                    amg_anim_scratch_pixels(baseX + 3) = pal32((packLo \ 16777216) AND 255)
                    amg_anim_scratch_pixels(baseX + 2) = pal32((packLo \ 65536) AND 255)
                    amg_anim_scratch_pixels(baseX + 1) = pal32((packLo \ 256) AND 255)
                    amg_anim_scratch_pixels(baseX) = pal32(packLo AND 255)
                CASE 5
                    amg_anim_scratch_pixels(baseX + 4) = pal32(packHi AND 255)
                    amg_anim_scratch_pixels(baseX + 3) = pal32((packLo \ 16777216) AND 255)
                    amg_anim_scratch_pixels(baseX + 2) = pal32((packLo \ 65536) AND 255)
                    amg_anim_scratch_pixels(baseX + 1) = pal32((packLo \ 256) AND 255)
                    amg_anim_scratch_pixels(baseX) = pal32(packLo AND 255)
                CASE 4
                    amg_anim_scratch_pixels(baseX + 3) = pal32((packLo \ 16777216) AND 255)
                    amg_anim_scratch_pixels(baseX + 2) = pal32((packLo \ 65536) AND 255)
                    amg_anim_scratch_pixels(baseX + 1) = pal32((packLo \ 256) AND 255)
                    amg_anim_scratch_pixels(baseX) = pal32(packLo AND 255)
                CASE 3
                    amg_anim_scratch_pixels(baseX + 2) = pal32((packLo \ 65536) AND 255)
                    amg_anim_scratch_pixels(baseX + 1) = pal32((packLo \ 256) AND 255)
                    amg_anim_scratch_pixels(baseX) = pal32(packLo AND 255)
                CASE 2
                    amg_anim_scratch_pixels(baseX + 1) = pal32((packLo \ 256) AND 255)
                    amg_anim_scratch_pixels(baseX) = pal32(packLo AND 255)
                CASE 1
                    amg_anim_scratch_pixels(baseX) = pal32(packLo AND 255)
            END SELECT
        END IF
    NEXT y

    frameMem = AmgAnimCanvasMem(animId)
    IF _MEMEXISTS(frameMem) = 0 THEN EXIT SUB
    _MEMPUT frameMem, frameMem.OFFSET, amg_anim_scratch_pixels()
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation build frame by number.
' Parameters: anim = working value for animation; frames = dynamic array that stores per-frame data or cached frame metadata; pal = working value for pal; planarBase = working value for planar base; planarA = working value for planar a; planarB = working value for planar b; additional parameters continue the same pattern.
SUB AmgAnimBuildFrameByNumber (anim AS AmgAnimInfo, frames() AS AmgAnimFrameInfo, pal() AS AmgAnimRGB8, planarBase() AS _UNSIGNED _BYTE, planarA() AS _UNSIGNED _BYTE, planarB() AS _UNSIGNED _BYTE, frameNumber AS LONG, chunky() AS _UNSIGNED _BYTE, ok AS LONG)
    ' Variable: frameIndex stores the index variable used to address the current item.
    DIM frameIndex AS LONG
    ' Variable: shownIsA stores the working value for shown is a.
    DIM shownIsA AS LONG
    ' Variable: usePrev stores the working value for use prev.
    DIM usePrev AS LONG

    ok = 0
    IF frameNumber < 0 THEN EXIT SUB
    IF frameNumber > anim.frameCount - 1 THEN EXIT SUB

    CALL AmgAnimCopyPlanarBuffer(planarBase(), planarA())
    CALL AmgAnimCopyPlanarBuffer(planarBase(), planarB())

    IF frames(0).hasCMAP THEN
        CALL AmgAnimReadCMAPAt(frames(0).cmapOfs, frames(0).cmapSize, pal())
    END IF

    shownIsA = -1

    IF frameNumber = 0 THEN
        CALL AmgAnimPlanarToChunky(anim, planarA(), chunky())
        ok = -1
        EXIT SUB
    END IF

    ' Loop purpose: iterate through animation frames while building, seeking, or updating playback state.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR frameIndex = 1 TO frameNumber
        usePrev = 0
        IF frames(frameIndex).interleave = 1 THEN usePrev = -1

        IF shownIsA THEN
            IF usePrev THEN
                CALL AmgAnimCopyPlanarBuffer(planarA(), planarB())
            END IF

            CALL AmgAnimDecodeFrameToHidden(anim, frames(frameIndex), planarB(), pal())
            shownIsA = 0
        ELSE
            IF usePrev THEN
                CALL AmgAnimCopyPlanarBuffer(planarB(), planarA())
            END IF

            CALL AmgAnimDecodeFrameToHidden(anim, frames(frameIndex), planarA(), pal())
            shownIsA = -1
        END IF
    NEXT frameIndex

    IF shownIsA THEN
        CALL AmgAnimPlanarToChunky(anim, planarA(), chunky())
    ELSE
        CALL AmgAnimPlanarToChunky(anim, planarB(), chunky())
    END IF

    ok = -1
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation get frame count internal.
' Parameters: fileName = string holding a file path or a human-readable name.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimGetFrameCountInternal& (fileName AS STRING)
    ' Variable: anim stores the working value for animation.
    DIM anim AS AmgAnimInfo
    ' dynamic array: frames is resized here to hold the dynamic array that stores per-frame data or cached frame metadata.
    REDIM frames(0 TO 0) AS AmgAnimFrameInfo
    ' dynamic array: pal is resized here to hold the working value for pal.
    REDIM pal(0 TO 0) AS AmgAnimRGB8
    ' Variable: ok stores the success flag returned by the current routine.
    DIM ok AS LONG

    AmgAnimGetFrameCountInternal = 0
    CALL AmgAnimLoadFileToBuffer(fileName, ok)
    IF ok = 0 THEN EXIT FUNCTION
    CALL AmgAnimUseScratchBuffer

    CALL AmgAnimLoadIndex(anim, frames(), pal())
    AmgAnimGetFrameCountInternal = anim.frameCount
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation extract frame image internal.
' Parameters: animId = working value for animation id; frameNumber = working value for frame number.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimExtractFrameImageInternal& (animId AS LONG, frameNumber AS LONG)
    ' Variable: img stores the QB64 image handle used to store or draw decoded pixels.
    DIM img AS LONG

    AmgAnimExtractFrameImageInternal = -1
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION
    IF AmgAnimItems(animId).CanvasImage > -2 THEN EXIT FUNCTION
    IF AmgAnimRenderFrameToCanvas(animId, frameNumber) = 0 THEN EXIT FUNCTION

    img = _COPYIMAGE(AmgAnimItems(animId).CanvasImage, 32)
    IF img > -2 THEN EXIT FUNCTION

    AmgAnimExtractFrameImageInternal = img
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation alloc planar block.
' Parameters: byteCount = count used to size or iterate the current data set.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimAllocPlanarBlock& (byteCount AS LONG)
    ' Variable: startIndex stores the index variable used to address the current item.
    DIM startIndex AS LONG
    ' Variable: neededTop stores the working value for needed top.
    DIM neededTop AS LONG

    AmgAnimAllocPlanarBlock = -1
    IF byteCount <= 0 THEN EXIT FUNCTION

    startIndex = amg_anim_planar_pool_used
    neededTop = startIndex + byteCount - 1

    IF neededTop > UBOUND(amg_anim_planar_pool) THEN
        ' dynamic array: amg_anim_planar_pool is resized here to hold the working value for Amiga animation planar pool.
        REDIM _PRESERVE amg_anim_planar_pool(0 TO neededTop) AS _UNSIGNED _BYTE
    END IF

    amg_anim_planar_pool_used = startIndex + byteCount
    AmgAnimAllocPlanarBlock = startIndex
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation alloc chunky block.
' Parameters: byteCount = count used to size or iterate the current data set.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimAllocChunkyBlock& (byteCount AS LONG)
    ' Variable: startIndex stores the index variable used to address the current item.
    DIM startIndex AS LONG
    ' Variable: neededTop stores the working value for needed top.
    DIM neededTop AS LONG

    AmgAnimAllocChunkyBlock = -1
    IF byteCount <= 0 THEN EXIT FUNCTION

    startIndex = amg_anim_chunky_pool_used
    neededTop = startIndex + byteCount - 1

    IF neededTop > UBOUND(amg_anim_chunky_pool) THEN
        ' dynamic array: amg_anim_chunky_pool is resized here to hold the working value for Amiga animation chunky pool.
        REDIM _PRESERVE amg_anim_chunky_pool(0 TO neededTop) AS _UNSIGNED _BYTE
    END IF

    amg_anim_chunky_pool_used = startIndex + byteCount
    AmgAnimAllocChunkyBlock = startIndex
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation alloc pixels block.
' Parameters: pixelCount = count used to size or iterate the current data set.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimAllocPixelsBlock& (pixelCount AS LONG)
    ' Variable: startIndex stores the index variable used to address the current item.
    DIM startIndex AS LONG
    ' Variable: neededTop stores the working value for needed top.
    DIM neededTop AS LONG

    AmgAnimAllocPixelsBlock = -1
    IF pixelCount <= 0 THEN EXIT FUNCTION

    startIndex = amg_anim_pixels_pool_used
    neededTop = startIndex + pixelCount - 1

    IF neededTop > UBOUND(amg_anim_pixels_pool) THEN
        ' dynamic array: amg_anim_pixels_pool is resized here to hold the working value for Amiga animation pixels pool.
        REDIM _PRESERVE amg_anim_pixels_pool(0 TO neededTop) AS _UNSIGNED LONG
    END IF

    amg_anim_pixels_pool_used = startIndex + pixelCount
    AmgAnimAllocPixelsBlock = startIndex
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation alloc palette block.
' Parameters: colorCount = column index or color-related value.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimAllocPaletteBlock& (colorCount AS LONG)
    ' Variable: startIndex stores the index variable used to address the current item.
    DIM startIndex AS LONG
    ' Variable: neededTop stores the working value for needed top.
    DIM neededTop AS LONG

    AmgAnimAllocPaletteBlock = -1
    IF colorCount <= 0 THEN EXIT FUNCTION

    startIndex = amg_anim_palette_pool_used
    neededTop = startIndex + colorCount - 1

    IF neededTop > UBOUND(amg_anim_palette_pool) THEN
        ' dynamic array: amg_anim_palette_pool is resized here to hold the palette storage or palette index used during indexed-color decoding.
        REDIM _PRESERVE amg_anim_palette_pool(0 TO neededTop) AS AmgAnimRGB8
    END IF

    amg_anim_palette_pool_used = startIndex + colorCount
    AmgAnimAllocPaletteBlock = startIndex
END FUNCTION

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation ensure scratch capacity.
' Parameters: planarSize = working value for planar size; chunkySize = working value for chunky size; palSize = working value for pal size.
SUB AmgAnimEnsureScratchCapacity (planarSize AS LONG, chunkySize AS LONG, palSize AS LONG)
    IF planarSize > amg_anim_scratch_planar_size THEN
        ' dynamic array: amg_anim_scratch_planar_base is resized here to hold the working value for Amiga animation scratch planar base.
        REDIM amg_anim_scratch_planar_base(0 TO planarSize - 1) AS _UNSIGNED _BYTE
        ' dynamic array: amg_anim_scratch_planar_a is resized here to hold the working value for Amiga animation scratch planar a.
        REDIM amg_anim_scratch_planar_a(0 TO planarSize - 1) AS _UNSIGNED _BYTE
        ' dynamic array: amg_anim_scratch_planar_b is resized here to hold the working value for Amiga animation scratch planar b.
        REDIM amg_anim_scratch_planar_b(0 TO planarSize - 1) AS _UNSIGNED _BYTE
        amg_anim_scratch_planar_size = planarSize
    END IF

    IF chunkySize > amg_anim_scratch_chunky_size THEN
        ' dynamic array: amg_anim_scratch_chunky is resized here to hold the working value for Amiga animation scratch chunky.
        REDIM amg_anim_scratch_chunky(0 TO chunkySize - 1) AS _UNSIGNED _BYTE
        amg_anim_scratch_chunky_size = chunkySize
    END IF

    IF chunkySize > amg_anim_scratch_pixels_size THEN
        ' dynamic array: amg_anim_scratch_pixels is resized here to hold the working value for Amiga animation scratch pixels.
        REDIM amg_anim_scratch_pixels(0 TO chunkySize - 1) AS _UNSIGNED LONG
        amg_anim_scratch_pixels_size = chunkySize
    END IF

    IF palSize <= 0 THEN palSize = 1
    IF palSize > amg_anim_scratch_pal_size THEN
        ' dynamic array: amg_anim_scratch_pal is resized here to hold the working value for Amiga animation scratch pal.
        REDIM amg_anim_scratch_pal(0 TO palSize - 1) AS AmgAnimRGB8
        amg_anim_scratch_pal_size = palSize
    END IF
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation get stored info.
' Parameters: animId = working value for animation id; anim = working value for animation.
SUB AmgAnimGetStoredInfo (animId AS LONG, anim AS AmgAnimInfo)
    anim.frameCount = AmgAnimItems(animId).FrameCount
    anim.w = AmgAnimItems(animId).WidthPx
    anim.h = AmgAnimItems(animId).HeightPx
    anim.nPlanes = AmgAnimItems(animId).NPlanes
    anim.rowBytes = AmgAnimItems(animId).RowBytes
    anim.planeSize = AmgAnimItems(animId).PlaneSize
    anim.compression = AmgAnimItems(animId).Compression
    anim.camg = AmgAnimItems(animId).Camg
    anim.isHAM = AmgAnimItems(animId).IsHam
    anim.firstFrameReady = -1
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation copy local palette to pool.
' Parameters: pal = working value for pal; dstStart = working value for dst start; colorCount = column index or color-related value.
SUB AmgAnimCopyLocalPaletteToPool (pal() AS AmgAnimRGB8, dstStart AS LONG, colorCount AS LONG)
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG
    ' Variable: copyCount stores the count used to size or iterate the current data set.
    DIM copyCount AS LONG
    IF dstStart < 0 THEN EXIT SUB
    copyCount = colorCount
    IF copyCount <= 0 THEN EXIT SUB
    IF copyCount > UBOUND(pal) + 1 THEN copyCount = UBOUND(pal) + 1
    ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 0 TO copyCount - 1
        amg_anim_palette_pool(dstStart + i) = pal(i)
    NEXT i
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation copy pool palette to local.
' Parameters: srcStart = working value for src start; colorCount = column index or color-related value; pal = working value for pal.
SUB AmgAnimCopyPoolPaletteToLocal (srcStart AS LONG, colorCount AS LONG, pal() AS AmgAnimRGB8)
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG
    IF colorCount <= 0 THEN
        ' dynamic array: pal is resized here to hold the working value for pal.
        REDIM pal(0 TO 0) AS AmgAnimRGB8
        EXIT SUB
    END IF
    ' dynamic array: pal is resized here to hold the working value for pal.
    REDIM pal(0 TO colorCount - 1) AS AmgAnimRGB8
    ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 0 TO colorCount - 1
        pal(i) = amg_anim_palette_pool(srcStart + i)
    NEXT i
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation copy local planar to pool.
' Parameters: src = source-side value or buffer reference; dstStart = working value for dst start; byteCount = count used to size or iterate the current data set.
SUB AmgAnimCopyLocalPlanarToPool (src() AS _UNSIGNED _BYTE, dstStart AS LONG, byteCount AS LONG)
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG

    IF dstStart < 0 THEN EXIT SUB
    IF byteCount <= 0 THEN EXIT SUB

    ' _MemPut na celé pole tady není bezpečný, protože zapíše celý reálný rozměr src(),
    ' ne jen byteCount bajtů. Když je src() větší než cílový výřez v poolu,
    ' skončí to chybou "memory region out of range".
    FOR i = 0 TO byteCount - 1
        amg_anim_planar_pool(dstStart + i) = src(i)
    NEXT i
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation copy pool planar to local.
' Parameters: srcStart = working value for src start; byteCount = count used to size or iterate the current data set; dst = destination-side value or buffer reference.
SUB AmgAnimCopyPoolPlanarToLocal (srcStart AS LONG, byteCount AS LONG, dst() AS _UNSIGNED _BYTE)
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG

    IF byteCount <= 0 THEN EXIT SUB

    ' Stejný důvod jako výše: _MemGet do celého pole dst() nectí byteCount.
    FOR i = 0 TO byteCount - 1
        dst(i) = amg_anim_planar_pool(srcStart + i)
    NEXT i
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation copy local chunky to pool.
' Parameters: src = source-side value or buffer reference; dstStart = working value for dst start; byteCount = count used to size or iterate the current data set.
SUB AmgAnimCopyLocalChunkyToPool (src() AS _UNSIGNED _BYTE, dstStart AS LONG, byteCount AS LONG)
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG
    IF dstStart < 0 THEN EXIT SUB
    IF byteCount <= 0 THEN EXIT SUB
    ' Loop purpose: walk through a byte-oriented range while parsing or transforming packed data.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 0 TO byteCount - 1
        amg_anim_chunky_pool(dstStart + i) = src(i)
    NEXT i
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation copy local pixels to pool.
' Parameters: src = source-side value or buffer reference; dstStart = working value for dst start; pixelCount = count used to size or iterate the current data set.
SUB AmgAnimCopyLocalPixelsToPool (src() AS _UNSIGNED LONG, dstStart AS LONG, pixelCount AS LONG)
    ' Variable: i stores the general-purpose loop index.
    DIM i AS LONG
    IF dstStart < 0 THEN EXIT SUB
    IF pixelCount <= 0 THEN EXIT SUB
    ' Loop purpose: use i as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR i = 0 TO pixelCount - 1
        amg_anim_pixels_pool(dstStart + i) = src(i)
    NEXT i
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation get frame info.
' Parameters: animId = working value for animation id; frameIndex = index variable used to address the current item; frameInfo = working value for frame info.
SUB AmgAnimGetFrameInfo (animId AS LONG, frameIndex AS LONG, frameInfo AS AmgAnimFrameInfo)
    frameInfo = AmgAnimFrames(AmgAnimItems(animId).FrameStart + frameIndex)
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation copy local palette to scratch.
' Parameters: pal = working value for pal.
SUB AmgAnimCopyLocalPaletteToScratch (pal() AS AmgAnimRGB8)
    ' Variable: colorCount stores the column index or color-related value.
    DIM colorCount AS LONG
    ' Variable: indexValue stores the working value for index value.
    DIM indexValue AS LONG

    colorCount = UBOUND(pal) + 1
    IF colorCount <= 0 THEN colorCount = 1

    IF colorCount > amg_anim_scratch_pal_size THEN
        ' dynamic array: amg_anim_scratch_pal is resized here to hold the working value for Amiga animation scratch pal.
        REDIM amg_anim_scratch_pal(0 TO colorCount - 1) AS AmgAnimRGB8
        amg_anim_scratch_pal_size = colorCount
    END IF

    ' Loop purpose: use indexValue as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR indexValue = 0 TO colorCount - 1
        amg_anim_scratch_pal(indexValue) = pal(indexValue)
    NEXT indexValue
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation copy scratch palette to local.
' Parameters: colorCount = column index or color-related value; pal = working value for pal.
SUB AmgAnimCopyScratchPaletteToLocal (colorCount AS LONG, pal() AS AmgAnimRGB8)
    ' Variable: indexValue stores the working value for index value.
    DIM indexValue AS LONG

    IF colorCount <= 0 THEN colorCount = 1
    ' dynamic array: pal is resized here to hold the working value for pal.
    REDIM pal(0 TO colorCount - 1) AS AmgAnimRGB8

    ' Loop purpose: use indexValue as a counter/index while the routine processes a repeated set of values.
    ' The loop order matters because later statements expect the data to be visited sequentially.
    FOR indexValue = 0 TO colorCount - 1
        pal(indexValue) = amg_anim_scratch_pal(indexValue)
    NEXT indexValue
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation flush scratch owner.
SUB AmgAnimFlushScratchOwner ()
    ' Variable: ownerId stores the working value for owner id.
    DIM ownerId AS LONG
    ' Variable: totalPlanar stores the working value for total planar.
    DIM totalPlanar AS LONG
    ' Variable: totalChunky stores the working value for total chunky.
    DIM totalChunky AS LONG

    IF amg_anim_scratch_owner_valid = 0 THEN EXIT SUB
    ownerId = amg_anim_scratch_owner
    IF AmgAnimValidId(ownerId) = 0 THEN
        amg_anim_scratch_owner_valid = 0
        EXIT SUB
    END IF
    IF AmgAnimItems(ownerId).WorkReady = 0 THEN EXIT SUB

    totalPlanar = AmgAnimItems(ownerId).RowBytes * AmgAnimItems(ownerId).HeightPx * AmgAnimItems(ownerId).NPlanes
    totalChunky = AmgAnimItems(ownerId).WidthPx * AmgAnimItems(ownerId).HeightPx
    CALL AmgAnimCopyLocalPlanarToPool(amg_anim_scratch_planar_base(), AmgAnimItems(ownerId).WorkBaseStart, totalPlanar)
    CALL AmgAnimCopyLocalPlanarToPool(amg_anim_scratch_planar_a(), AmgAnimItems(ownerId).WorkAStart, totalPlanar)
    CALL AmgAnimCopyLocalPlanarToPool(amg_anim_scratch_planar_b(), AmgAnimItems(ownerId).WorkBStart, totalPlanar)
    CALL AmgAnimCopyLocalPaletteToPool(amg_anim_scratch_pal(), AmgAnimItems(ownerId).PalStart, AmgAnimItems(ownerId).PalCount)
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation restore work to scratch.
' Parameters: animId = working value for animation id; anim = working value for animation; pal = working value for pal.
SUB AmgAnimRestoreWorkToScratch (animId AS LONG, anim AS AmgAnimInfo, pal() AS AmgAnimRGB8)
    ' Variable: totalPlanar stores the working value for total planar.
    DIM totalPlanar AS LONG
    ' Variable: totalChunky stores the working value for total chunky.
    DIM totalChunky AS LONG

    totalPlanar = anim.rowBytes * anim.h * anim.nPlanes
    totalChunky = anim.w * anim.h
    CALL AmgAnimEnsureScratchCapacity(totalPlanar, totalChunky, AmgAnimItems(animId).PalCount)

    IF amg_anim_scratch_owner_valid THEN
        IF amg_anim_scratch_owner = animId THEN
            CALL AmgAnimCopyScratchPaletteToLocal(AmgAnimItems(animId).PalCount, pal())
            EXIT SUB
        END IF

        CALL AmgAnimFlushScratchOwner
    END IF

    CALL AmgAnimCopyPoolPlanarToLocal(AmgAnimItems(animId).WorkBaseStart, totalPlanar, amg_anim_scratch_planar_base())
    CALL AmgAnimCopyPoolPlanarToLocal(AmgAnimItems(animId).WorkAStart, totalPlanar, amg_anim_scratch_planar_a())
    CALL AmgAnimCopyPoolPlanarToLocal(AmgAnimItems(animId).WorkBStart, totalPlanar, amg_anim_scratch_planar_b())
    CALL AmgAnimCopyPoolPaletteToLocal(AmgAnimItems(animId).PalStart, AmgAnimItems(animId).PalCount, pal())
    CALL AmgAnimCopyLocalPaletteToScratch(pal())
    amg_anim_scratch_owner = animId
    amg_anim_scratch_owner_valid = -1
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation save scratch work.
' Parameters: animId = working value for animation id; pal = working value for pal; totalPlanar = working value for total planar; totalChunky = working value for total chunky.
SUB AmgAnimSaveScratchWork (animId AS LONG, pal() AS AmgAnimRGB8)
    CALL AmgAnimCopyLocalPaletteToScratch(pal())
    amg_anim_scratch_owner = animId
    amg_anim_scratch_owner_valid = -1
END SUB

' Purpose: Routine for the Amiga ANIM backend: handle Amiga animation prepare base state.
' Parameters: animId = working value for animation id.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimPrepareBaseState% (animId AS LONG)
    ' Variable: anim stores the working value for animation.
    DIM anim AS AmgAnimInfo
    ' dynamic array: pal is resized here to hold the working value for pal.
    REDIM pal(0 TO 0) AS AmgAnimRGB8
    ' Variable: totalPlanar stores the working value for total planar.
    DIM totalPlanar AS LONG
    ' Variable: totalChunky stores the working value for total chunky.
    DIM totalChunky AS LONG
    ' Variable: frame0 stores the working value for frame 0.
    DIM frame0 AS AmgAnimFrameInfo

    AmgAnimPrepareBaseState = 0
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION

    CALL AmgAnimGetStoredInfo(animId, anim)
    totalPlanar = anim.rowBytes * anim.h * anim.nPlanes
    totalChunky = anim.w * anim.h
    CALL AmgAnimEnsureScratchCapacity(totalPlanar, totalChunky, AmgAnimItems(animId).PalCount)
    CALL AmgAnimFlushScratchOwner
    CALL AmgAnimCopyPoolPaletteToLocal(AmgAnimItems(animId).PalStart, AmgAnimItems(animId).PalCount, pal())
    CALL AmgAnimGetFrameInfo(animId, 0, frame0)

    CALL AmgAnimUseSlotBuffer(animId)
    CALL AmgAnimLoadFirstFramePlanar(anim, frame0, amg_anim_scratch_planar_base(), amg_anim_scratch_planar_a(), pal())
    CALL AmgAnimCopyPlanarBuffer(amg_anim_scratch_planar_base(), amg_anim_scratch_planar_b())
    CALL AmgAnimRenderPlanarFrameMem(animId, anim, pal(), amg_anim_scratch_planar_a())
    CALL AmgAnimSaveScratchWork(animId, pal())

    AmgAnimItems(animId).DecodedFrame = 0
    AmgAnimItems(animId).ShownIsA = -1
    AmgAnimItems(animId).WorkReady = -1
    CALL AmgAnimMaybeStoreSnapshot(animId, 0)
    AmgAnimPrepareBaseState = -1
END FUNCTION

' Purpose: Convert decoded Amiga bitmap state into a QB64 image.
' Parameters: animId = working value for animation id; frameNumber = working value for frame number.
' Return value: the function result follows the success/failure or data-return convention used by this module.
FUNCTION AmgAnimRenderFrameToCanvas% (animId AS LONG, frameNumber AS LONG)
    ' Variable: anim stores the working value for animation.
    DIM anim AS AmgAnimInfo
    ' dynamic array: pal is resized here to hold the working value for pal.
    REDIM pal(0 TO 0) AS AmgAnimRGB8
    ' Variable: totalPlanar stores the working value for total planar.
    DIM totalPlanar AS LONG
    ' Variable: totalChunky stores the working value for total chunky.
    DIM totalChunky AS LONG
    ' Variable: frameIndex stores the index variable used to address the current item.
    DIM frameIndex AS LONG
    ' Variable: usePrev stores the working value for use prev.
    DIM usePrev AS LONG
    ' Variable: frame0 stores the working value for frame 0.
    DIM frame0 AS AmgAnimFrameInfo
    ' Variable: curFrame stores the working value for cur frame.
    DIM curFrame AS AmgAnimFrameInfo
    ' Variable: restoredFrame stores the working value for restored frame.
    DIM restoredFrame AS LONG

    AmgAnimRenderFrameToCanvas = 0
    IF AmgAnimValidId(animId) = 0 THEN EXIT FUNCTION
    IF frameNumber < 0 THEN EXIT FUNCTION
    IF frameNumber >= AmgAnimItems(animId).FrameCount THEN EXIT FUNCTION
    IF AmgAnimItems(animId).CanvasImage > -2 THEN EXIT FUNCTION

    CALL AmgAnimGetStoredInfo(animId, anim)
    totalPlanar = anim.rowBytes * anim.h * anim.nPlanes
    totalChunky = anim.w * anim.h
    CALL AmgAnimEnsureScratchCapacity(totalPlanar, totalChunky, AmgAnimItems(animId).PalCount)

    IF AmgAnimItems(animId).WorkReady = 0 THEN
        IF AmgAnimPrepareBaseState(animId) = 0 THEN EXIT FUNCTION
        IF frameNumber = 0 THEN
            AmgAnimItems(animId).RenderedFrame = 0
            AmgAnimRenderFrameToCanvas = -1
            EXIT FUNCTION
        END IF
    END IF

    CALL AmgAnimRestoreWorkToScratch(animId, anim, pal())
    CALL AmgAnimUseSlotBuffer(animId)

    IF frameNumber = 0 THEN
        CALL AmgAnimGetFrameInfo(animId, 0, frame0)
        CALL AmgAnimLoadFirstFramePlanar(anim, frame0, amg_anim_scratch_planar_base(), amg_anim_scratch_planar_a(), pal())
        CALL AmgAnimCopyPlanarBuffer(amg_anim_scratch_planar_base(), amg_anim_scratch_planar_b())
        CALL AmgAnimRenderPlanarFrameMem(animId, anim, pal(), amg_anim_scratch_planar_a())
        CALL AmgAnimSaveScratchWork(animId, pal())
        AmgAnimItems(animId).DecodedFrame = 0
        AmgAnimItems(animId).ShownIsA = -1
        AmgAnimItems(animId).RenderedFrame = 0
        AmgAnimItems(animId).WorkReady = -1
        CALL AmgAnimMaybeStoreSnapshot(animId, 0)
        AmgAnimRenderFrameToCanvas = -1
        EXIT FUNCTION
    END IF

    IF frameNumber < AmgAnimItems(animId).DecodedFrame THEN
        restoredFrame = -1
        IF AmgAnimRestoreNearestSnapshot(animId, frameNumber, anim, pal(), restoredFrame) = 0 THEN
            CALL AmgAnimGetFrameInfo(animId, 0, frame0)
            CALL AmgAnimLoadFirstFramePlanar(anim, frame0, amg_anim_scratch_planar_base(), amg_anim_scratch_planar_a(), pal())
            CALL AmgAnimCopyPlanarBuffer(amg_anim_scratch_planar_base(), amg_anim_scratch_planar_b())
            AmgAnimItems(animId).DecodedFrame = 0
            AmgAnimItems(animId).ShownIsA = -1
        END IF
    END IF

    IF frameNumber > AmgAnimItems(animId).DecodedFrame THEN
        frameIndex = AmgAnimItems(animId).DecodedFrame + 1
        ' Loop purpose: keep processing until the controlling condition becomes false, usually while input or timing remains active.
        DO WHILE frameIndex <= frameNumber
            usePrev = 0
            CALL AmgAnimGetFrameInfo(animId, frameIndex, curFrame)
            IF curFrame.interleave = 1 THEN usePrev = -1

            IF AmgAnimItems(animId).ShownIsA THEN
                IF usePrev THEN CALL AmgAnimCopyPlanarBuffer(amg_anim_scratch_planar_a(), amg_anim_scratch_planar_b())
                CALL AmgAnimDecodeFrameToHidden(anim, curFrame, amg_anim_scratch_planar_b(), pal())
                AmgAnimItems(animId).ShownIsA = 0
            ELSE
                IF usePrev THEN CALL AmgAnimCopyPlanarBuffer(amg_anim_scratch_planar_b(), amg_anim_scratch_planar_a())
                CALL AmgAnimDecodeFrameToHidden(anim, curFrame, amg_anim_scratch_planar_a(), pal())
                AmgAnimItems(animId).ShownIsA = -1
            END IF

            CALL AmgAnimMaybeStoreSnapshot(animId, frameIndex)
            frameIndex = frameIndex + 1
        LOOP
    END IF

    IF AmgAnimItems(animId).ShownIsA THEN
        CALL AmgAnimRenderPlanarFrameMem(animId, anim, pal(), amg_anim_scratch_planar_a())
    ELSE
        CALL AmgAnimRenderPlanarFrameMem(animId, anim, pal(), amg_anim_scratch_planar_b())
    END IF

    CALL AmgAnimSaveScratchWork(animId, pal())
    AmgAnimItems(animId).DecodedFrame = frameNumber
    AmgAnimItems(animId).RenderedFrame = frameNumber
    AmgAnimItems(animId).WorkReady = -1
    CALL AmgAnimMaybeStoreSnapshot(animId, frameNumber)
    AmgAnimRenderFrameToCanvas = -1
END FUNCTION

